{
  "AllowedHosts": "localhost;127.0.0.1;10.0.2.2",
  "RemoteImageBuffer": {
    "ImageLimit": 10,
    "MaxBytes": 134217728,
    "TimeToLiveMinutes": 30
  },
  "AcquisitionStorage": {
    "Enabled": true,
    "BaseFolder": "",
    "RequireSignedMetadata": true,
    "QuarantineIncompleteArtifacts": true,
    "IncompleteArtifactGracePeriodMinutes": 10
  },
  "AuditStorage": {
    "Enabled": true,
    "FilePath": "",
    "RequireSignedEntries": true,
    "MaximumFileBytes": 67108864
  },
  "AcquisitionSafety": {
    "GeneratorReadyTimeoutMs": 5000,
    "DetectorArmTimeoutMs": 5000,
    "ExposureStartTimeoutMs": 2000,
    "MaximumExposureDurationMs": 5000,
    "MaximumGrabDurationMs": 60000,
    "ExposureStopConfirmationTimeoutMs": 2000,
    "DetectorStopTimeoutMs": 2000,
    "FrameReadyTimeoutMs": 10000,
    "BufferCopyTimeoutMs": 5000
  },
  "RequestSecurity": {
    "RateLimitPermitCount": 120,
    "RateLimitWindowSeconds": 60,
    "MaximumApiRequestBodyBytes": 65536
  },
  "Security": {
    "RequireHttps": true,
    "AuthenticationEnabled": true,
    "CommandLeaseSeconds": 30,
    "ApiKeys": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
