<Window x:Class="XRaySystem.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CMOS X-Ray Telemetry System" Height="800" Width="1300"
        Background="#0B0F19"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen"
        PreviewMouseDown="Window_PreviewMouseDown">
    <Window.Resources>
        <Style x:Key="ModernInputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="IBeam"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#00F0FF"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                    <Setter Property="Background" Value="#0F172A"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#475569"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ValidationInputTextBoxStyle" BasedOn="{StaticResource ModernInputTextBoxStyle}" TargetType="TextBox">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ExposureTimeIsValid}" Value="False">
                    <Setter Property="BorderBrush" Value="#FF3B30"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="#131A2A"/>
            <Setter Property="BorderBrush" Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="10"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#00F0FF"/> 
            <Setter Property="Foreground" Value="#0B0F19"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="25,15"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#5CFFFF"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#1E293B"/>
                    <Setter Property="Foreground" Value="#64748B"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#FF3B30"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF6B63"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#1E293B"/>
                    <Setter Property="Foreground" Value="#64748B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AbortStopButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#D71920"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#FF8A92"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="MinWidth" Value="104"/>
            <Setter Property="Padding" Value="24,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="StopBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="StopBorder" Property="Background" Value="#F02A32"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="StopBorder" Property="Background" Value="#2A3343"/>
                                <Setter TargetName="StopBorder" Property="BorderBrush" Value="#4B5567"/>
                                <Setter Property="Foreground" Value="#7D899B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SnapModeComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F5F8FF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="3">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#151F32"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#163341"/>
                                <Setter Property="Foreground" Value="#00E5FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#667991"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SnapModeComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#0A111E"/>
            <Setter Property="Foreground" Value="#F5F8FF"/>
            <Setter Property="BorderBrush" Value="#38506F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="12,0,42,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="MaxDropDownHeight" Value="180"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource SnapModeComboBoxItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="FieldBorder"
                                                Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                CornerRadius="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="38"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="1"
                                                        BorderBrush="#25344D"
                                                        BorderThickness="1,0,0,0">
                                                    <Path x:Name="Arrow"
                                                          Data="M 0 0 L 4 4 L 8 0 Z"
                                                          Fill="#A7B6C9"
                                                          Width="8"
                                                          Height="4"
                                                          Stretch="Fill"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="#00E5FF"/>
                                                <Setter TargetName="Arrow" Property="Fill" Value="#00E5FF"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="FieldBorder" Property="Background" Value="#0D1422"/>
                                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="#00E5FF"/>
                                                <Setter TargetName="Arrow" Property="Fill" Value="#00E5FF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="SelectedContent"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              ContentSource="SelectionBoxItem"/>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Fade">
                                <Border Margin="0,4,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="#0D1422"
                                        BorderBrush="#38506F"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="4">
                                    <ScrollViewer CanContentScroll="True"
                                                  VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="#00E5FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#151F32"/>
                                <Setter Property="BorderBrush" Value="#25344D"/>
                                <Setter Property="Foreground" Value="#667991"/>
                                <Setter TargetName="SelectedContent" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MetricLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="MetricValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="FontWeight" Value="Light"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>

        <!-- Modern Ultra-Sleek Dark ScrollBar Style (Kötü duran gri kutuyu kaldırır) -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Bg" Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb Background="#334155">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="2.5"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Focusable="True" FocusVisualStyle="{x:Null}" Background="Transparent" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <!-- Comparison selection bar -->
            <RowDefinition x:Name="CompBarRow" Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="10,0,10,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Orientation="Vertical">
                <TextBlock Text="X-RAY VISION CORE" Foreground="#FFFFFF" FontSize="28" FontWeight="Bold"/>
                <TextBlock Text="INDUSTRIAL CMOS SENSOR TELEMETRY" Foreground="#00F0FF" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,0"/>
                <TextBlock Text="{Binding DataSourceStatusText}"
                           AutomationProperties.AutomationId="DataSourceStatusText"
                           AutomationProperties.Name="Image data source status"
                           Foreground="{Binding DataSourceStatusColor}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Margin="0,4,0,0"/>
                <TextBlock Text="{Binding ObservedControlStateText}"
                           AutomationProperties.AutomationId="ObservedControlStateText"
                           AutomationProperties.Name="Observed device control state"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Margin="0,4,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#A7B6C9"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRemoteOperatorActive}" Value="True">
                                    <Setter Property="Foreground" Value="#00E5FF"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
                     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding SnapCommand}"
                        AutomationProperties.AutomationId="SnapButton"
                        Margin="0,0,10,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                            <Setter Property="Background" Value="#FF9500"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Setter Property="Content" Value="{Binding SnapActionText}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSnapping}" Value="True">
                                    <Setter Property="Content" Value="SNAPPING..."/>
                                    <Setter Property="Background" Value="#FFD60A"/>
                                    <Setter Property="Foreground" Value="#000000"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsObservedSnapping}" Value="True">
                                    <Setter Property="Content" Value="SNAPPING..."/>
                                    <Setter Property="Background" Value="#FFD60A"/>
                                    <Setter Property="Foreground" Value="#000000"/>
                                    <Setter Property="Opacity" Value="1"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsObservedFrozen}" Value="True">
                                    <Setter Property="Background" Value="#FF9500"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                    <Setter Property="Opacity" Value="1"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="{Binding StartGrabActionText}"
                        Command="{Binding StartGrabCommand}"
                        AutomationProperties.AutomationId="StartGrabButton"
                        Margin="0,0,10,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsObservedGrabbing}" Value="True">
                                    <Setter Property="Background" Value="#163A27"/>
                                    <Setter Property="Foreground" Value="#32D74B"/>
                                    <Setter Property="Opacity" Value="1"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="FREEZE"
                        Command="{Binding StopCommand}"
                        AutomationProperties.AutomationId="FreezeGrabButton"
                        AutomationProperties.Name="Freeze grab"
                        AutomationProperties.HelpText="Stops GRAB normally and preserves the last image."
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="0,0,10,0"/>
                <Button Content="STOP"
                        Command="{Binding AbortCommand}"
                        AutomationProperties.AutomationId="AbortButton"
                        AutomationProperties.Name="Stop acquisition"
                        AutomationProperties.HelpText="Immediately aborts an active GRAB or SNAP. This software control does not replace the hardware emergency stop."
                        ToolTip="ABORT ACQUISITION — Immediately stops an active GRAB or SNAP. This software control does not replace the hardware emergency stop."
                        Style="{StaticResource AbortStopButtonStyle}"
                        Margin="0,0,10,0"/>
                <Button Command="{Binding ConnectCommand}"
                        AutomationProperties.AutomationId="ConnectButton"
                        Margin="0,0,10,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                            <Setter Property="Content" Value="CONNECT"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnecting}" Value="True">
                                    <Setter Property="Content" Value="CONNECTING..."/>
                                    <Setter Property="Background" Value="#1E293B"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsDeviceObservedConnected}" Value="True">
                                    <Setter Property="Content" Value="CONNECTED"/>
                                    <Setter Property="Background" Value="#163A27"/>
                                    <Setter Property="Foreground" Value="#32D74B"/>
                                    <Setter Property="Opacity" Value="1"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="DISCONNECT"
                        Command="{Binding DisconnectCommand}"
                        AutomationProperties.AutomationId="DisconnectButton"
                        Style="{StaticResource DangerButtonStyle}"/>
            </StackPanel>
        </Grid>

        <!-- CONTENT -->
        <Grid x:Name="ContentGrid" Grid.Row="1">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="0"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="270"/>
            </Grid.ColumnDefinitions>

            <!-- SOL PANEL: Metrikler ve Kullanıcı Parametre Girdileri -->
            <Grid x:Name="TelemetryPanel" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Canlı Metrikler -->
                <UniformGrid Grid.Row="0" Columns="2">
                    <Border Style="{StaticResource PanelStyle}" Margin="0,0,5,10">
                        <StackPanel>
                            <TextBlock Text="TUBE POWER" Style="{StaticResource MetricLabelStyle}"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                <TextBlock Text="{Binding LatestTelemetry.PowerW, StringFormat={}{0:F2}, FallbackValue=0.00}" Style="{StaticResource MetricValueStyle}"/>
                                <TextBlock Text=" W" Foreground="#64748B" FontSize="16" VerticalAlignment="Bottom" Margin="5,0,0,5"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PanelStyle}" Margin="5,0,0,10">
                        <StackPanel>
                            <TextBlock Text="TUBE VOLTAGE" Style="{StaticResource MetricLabelStyle}"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                <TextBlock Text="{Binding LatestTelemetry.Voltage, StringFormat={}{0:F2}, FallbackValue=0.00}" Style="{StaticResource MetricValueStyle}"/>
                                <TextBlock Text=" kV" Foreground="#64748B" FontSize="16" VerticalAlignment="Bottom" Margin="5,0,0,5"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PanelStyle}" Margin="0,0,5,10">
                        <StackPanel>
                            <TextBlock Text="INTENSITY" Style="{StaticResource MetricLabelStyle}"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                <TextBlock Text="{Binding LatestTelemetry.XRayIntensity, StringFormat={}{0:N0}, FallbackValue=0}" Style="{StaticResource MetricValueStyle}" Foreground="#00F0FF"/>
                                <TextBlock Text=" B" Foreground="#64748B" FontSize="16" VerticalAlignment="Bottom" Margin="5,0,0,5"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PanelStyle}" Margin="5,0,0,10">
                        <StackPanel>
                            <TextBlock Text="EXPOSURE" Style="{StaticResource MetricLabelStyle}"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                <TextBlock Text="{Binding LatestTelemetry.ExposureTime, StringFormat={}{0:F1}, FallbackValue=0.0}" Style="{StaticResource MetricValueStyle}"/>
                                <TextBlock Text=" ms" Foreground="#64748B" FontSize="16" VerticalAlignment="Bottom" Margin="5,0,0,5"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </UniformGrid>


                <!-- KULLANICI PARAMETRE GİRDİLERİ (X-RAY TUBE INPUTS) -->
                <Border Grid.Row="1" Style="{StaticResource PanelStyle}" Margin="0,0,0,10" Padding="16">
                    <StackPanel>
                        <TextBlock Text="ACQUISITION SETTINGS" Foreground="#00F0FF" FontSize="14" FontWeight="Bold" Margin="0,0,0,14"/>
                        <TextBlock Text="X-RAY GENERATOR" Foreground="#5CFFFF" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        
                        <!-- TUBE VOLTAGE (kV) INPUT -->
                        <TextBlock Text="TUBE VOLTAGE (kV):" Foreground="#64748B" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding UserVoltage, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource ModernInputTextBoxStyle}"/>
                            <TextBlock Grid.Column="1" Text="kV" Foreground="#94A3B8" FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>

                        <!-- TUBE POWER (WATT) INPUT -->
                        <TextBlock Text="TUBE POWER (W):" Foreground="#64748B" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding UserPowerW, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernInputTextBoxStyle}"/>
                            <TextBlock Grid.Column="1" Text="W" Foreground="#94A3B8" FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>

                        <TextBlock Text="DETECTOR" Foreground="#5CFFFF" FontSize="10" FontWeight="SemiBold" Margin="0,3,0,8"/>

                        <!-- EXPOSURE TIME (ms) INPUT -->
                        <TextBlock Text="EXPOSURE TIME (ms):" Foreground="#64748B" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding UserExposureTime, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource ValidationInputTextBoxStyle}"/>
                            <TextBlock Grid.Column="1" Text="ms" Foreground="#94A3B8" FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>

                        <TextBlock Text="SNAP DETECTOR MODE:"
                                   Foreground="#64748B"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Margin="0,8,0,4"/>
                        <ComboBox ItemsSource="{Binding SnapFrameModeOptions}"
                                  SelectedItem="{Binding SelectedSnapFrameMode, Mode=TwoWay}"
                                  IsEnabled="{Binding CanSelectSnapFrameMode}"
                                  AutomationProperties.AutomationId="SnapFrameModePicker"
                                  AutomationProperties.Name="SNAP detector mode"
                                  AutomationProperties.HelpText="Select LOW preview or RAW detector output for the next SNAP."
                                  Style="{StaticResource SnapModeComboBoxStyle}"/>

                        <TextBlock Text="{Binding ExposureValidationMessage}" FontSize="10" Margin="0,2,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#64748B"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ExposureTimeIsValid}" Value="False">
                                            <Setter Property="Foreground" Value="#FF3B30"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ORTA PANEL: Canlı Görüntü Matrisi -->
            <Border x:Name="ScanPanel" Grid.Column="1" Style="{StaticResource PanelStyle}" Margin="10,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Text="GRAB X-RAY SCAN MATRIX" Style="{StaticResource MetricLabelStyle}"/>
                    
                    <Border x:Name="XRayScanBorder" Grid.Row="1" BorderBrush="#334155" BorderThickness="1" Margin="0,15,0,0" CornerRadius="4" Background="#02040A" ClipToBounds="True"
                            MouseWheel="XRayImage_MouseWheel"
                            MouseLeftButtonDown="XRayImage_MouseLeftButtonDown"
                            MouseLeftButtonUp="XRayImage_MouseLeftButtonUp"
                            MouseMove="XRayImage_MouseMove"
                            MouseLeave="XRayImage_MouseLeave"
                            LostMouseCapture="XRayImage_LostMouseCapture"
                            Cursor="Cross">
                        <Grid x:Name="XRayContainer" Background="Transparent">
                            <!-- Only this layer is transformed; all HUD/control content remains viewport-fixed. -->
                            <Grid x:Name="ImageLayer" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                              <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="XRayScaleTransform" ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform x:Name="XRayTranslateTransform" X="0" Y="0"/>
                                </TransformGroup>
                              </Grid.RenderTransform>
                                <Image x:Name="XRayImage" Source="{Binding CurrentFrame}" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            </Grid>
                             
                            <!-- Viewport HUD: deliberately outside ImageLayer. -->
                            <Grid>
                                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="15" IsHitTestVisible="False">
                                    <TextBlock Text="{Binding CurrentFrameResolution}" Foreground="#00F0FF" FontSize="12" Opacity="0.7"/>
                                    <TextBlock Text="{Binding FrameFreshnessText}"
                                               AutomationProperties.AutomationId="FrameFreshnessText"
                                               Foreground="{Binding FrameFreshnessColor}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Margin="0,3,0,0"/>
                                    <TextBlock x:Name="MainCenterCoordinateText" Text="CENTER X: —  Y: —" Foreground="#A7B6C9" FontSize="11" Margin="0,3,0,0"/>
                                    <TextBlock x:Name="MainPointerCoordinateText" Text="POINTER X: —  Y: —" Foreground="#667991" FontSize="10" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- GRAB / SNAP / GEÇMİŞ İNCELEME STATUS ROZETİ -->
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="15" 
                                        Background="#0F172A" BorderBrush="{Binding ImageStatusBadgeColor}" BorderThickness="1.5"
                                        CornerRadius="6" Padding="12,6" IsHitTestVisible="False">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="10" Height="10" Fill="{Binding ImageStatusBadgeColor}" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding ImageStatusBadgeText}" 
                                                   Foreground="#FFFFFF" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Koordinata odaklanma için sabit viewport merkezi. -->
                                <Grid Width="24" Height="24"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      IsHitTestVisible="False">
                                    <Rectangle Height="1" Fill="#00E5FF" VerticalAlignment="Center"/>
                                    <Rectangle Width="1" Fill="#00E5FF" HorizontalAlignment="Center"/>
                                </Grid>

                                <!-- Zoom controls at bottom-left inside image viewport -->
                                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="15" Orientation="Horizontal">
                                    <Button Content="+" Width="30" Height="30" Background="#1E293B" Foreground="White" BorderThickness="1" BorderBrush="#334155" Margin="0,0,5,0" Cursor="Hand" Click="ZoomIn_Click"/>
                                    <Button Content="-" Width="30" Height="30" Background="#1E293B" Foreground="White" BorderThickness="1" BorderBrush="#334155" Margin="0,0,5,0" Cursor="Hand" Click="ZoomOut_Click"/>
                                    <Button Content="RESET" Height="30" Padding="10,0" Background="#1E293B" Foreground="White" BorderThickness="1" BorderBrush="#334155" Cursor="Hand" Click="ZoomReset_Click"/>
                                    <TextBlock x:Name="ZoomPercentText" Text="100%" Foreground="#FFFFFF" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>

                                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="15" IsHitTestVisible="False">
                                    <TextBlock Text="{Binding LatestTelemetry.Timestamp, StringFormat={}{0:yyyy-MM-dd HH:mm:ss.fff}}" Foreground="#00F0FF" FontSize="14" Opacity="0.8" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Gray16 Window / Level controls. Kept outside the transformed image layer. -->
                    <Border Grid.Row="2"
                            Margin="0,12,0,0"
                            Padding="12,10"
                            Background="#0D1422"
                            BorderBrush="#25344D"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="58"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="CENTER"
                                       Foreground="#667991"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                            <Slider Grid.Column="1"
                                    Minimum="0"
                                    Maximum="65535"
                                    Value="{Binding WCenter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    IsEnabled="{Binding HasRawSource}"
                                    VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding WCenter, StringFormat={}{0:F0}}"
                                       Foreground="#00E5FF"
                                       FontSize="11"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"/>

                            <TextBlock Grid.Row="1"
                                       Text="WIDTH"
                                       Foreground="#667991"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="0,3,10,0"/>
                            <Slider Grid.Row="1"
                                    Grid.Column="1"
                                    Minimum="1"
                                    Maximum="65535"
                                    Value="{Binding WWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    IsEnabled="{Binding HasRawSource}"
                                    VerticalAlignment="Center"
                                    Margin="0,3,0,0"/>
                            <TextBlock Grid.Row="1"
                                       Grid.Column="2"
                                       Text="{Binding WWidth, StringFormat={}{0:F0}}"
                                       Foreground="#00E5FF"
                                       FontSize="11"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center"
                                       Margin="8,3,0,0"/>

                            <StackPanel Grid.RowSpan="2"
                                        Grid.Column="3"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="14,0,0,0">
                                <Button Content="AUTO"
                                        Command="{Binding AutoWindowLevelCommand}"
                                        IsEnabled="{Binding HasRawSource}"
                                        Height="32"
                                        MinWidth="62"
                                        Padding="10,0"
                                        Background="#1E293B"
                                        Foreground="#F5F8FF"
                                        BorderBrush="#38506F"
                                        BorderThickness="1"
                                        Cursor="Hand"/>
                                <Button Content="RESET"
                                        Command="{Binding ResetWindowLevelCommand}"
                                        IsEnabled="{Binding HasRawSource}"
                                        Height="32"
                                        MinWidth="62"
                                        Margin="7,0,0,0"
                                        Padding="10,0"
                                        Background="#1E293B"
                                        Foreground="#F5F8FF"
                                        BorderBrush="#38506F"
                                        BorderThickness="1"
                                        Cursor="Hand"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2"
                                        Grid.ColumnSpan="4"
                                        Orientation="Horizontal"
                                        Margin="0,9,0,0">
                                <TextBlock Text="GO TO COORDINATE"
                                           Foreground="#667991"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>
                                <TextBlock Text="X" Foreground="#A7B6C9" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBox x:Name="MainCoordinateXInput"
                                         Width="70"
                                         Style="{StaticResource ModernInputTextBoxStyle}"
                                         ToolTip="Image pixel X coordinate"/>
                                <TextBlock Text="Y" Foreground="#A7B6C9" VerticalAlignment="Center" Margin="9,0,5,0"/>
                                <TextBox x:Name="MainCoordinateYInput"
                                         Width="70"
                                         Style="{StaticResource ModernInputTextBoxStyle}"
                                         ToolTip="Image pixel Y coordinate"/>
                                <TextBlock Text="ZOOM %" Foreground="#A7B6C9" VerticalAlignment="Center" Margin="9,0,5,0"/>
                                <TextBox x:Name="MainCoordinateZoomInput"
                                         Width="82"
                                         Text="800"
                                         Style="{StaticResource ModernInputTextBoxStyle}"
                                         ToolTip="Zoom percentage applied when focusing the coordinate"/>
                                <Button Content="FOCUS"
                                        Click="FocusCoordinate_Click"
                                        Height="34"
                                        MinWidth="72"
                                        Margin="9,0,0,0"
                                        Padding="10,0"
                                        Background="#1E293B"
                                        Foreground="#F5F8FF"
                                        BorderBrush="#38506F"
                                        BorderThickness="1"
                                        Cursor="Hand"/>
                                <TextBlock x:Name="MainCoordinateValidationText"
                                           Foreground="#FFB020"
                                           FontSize="10"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- SAĞ PANEL: Görsel Geçmişi (Image History) -->
            <Border x:Name="HistoryPanel" Grid.Column="2" Style="{StaticResource PanelStyle}" Margin="10,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Başlık, İpucu ve Klasör Butonu -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="IMAGE HISTORY" Foreground="#00F0FF" FontSize="13" FontWeight="Bold"/>
                        <TextBlock Text="Saved SNAP acquisitions" Foreground="#475569" FontSize="10" Margin="0,1,0,0"/>
                        <TextBlock x:Name="CompSelectionHint" 
                                   Text="Use + to select images for comparison (max 4)"
                                   Foreground="#64748B" FontSize="9.5" TextWrapping="Wrap" Margin="0,4,0,8"/>
                        
                        <!-- Klasör Aç Butonu: Projenin Standart Cyan Paleti -->
                        <Button Content="OPEN FOLDER"
                                Click="OpenImageFolder_Click" 
                                Background="#1E293B" Foreground="#00F0FF" BorderBrush="#334155" BorderThickness="1"
                                FontSize="11" FontWeight="Bold" Height="30" Cursor="Hand" HorizontalAlignment="Stretch">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#0F172A"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#00F0FF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <!-- Liste -->
                    <ListBox x:Name="ImageHistoryListBox"
                             Grid.Row="1"
                             ItemsSource="{Binding ImageHistory}"
                             Background="Transparent"
                             BorderThickness="0"
                             SelectionChanged="ImageHistoryListBox_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="BorderBrush" Value="#00F0FF"/>
                                        <Setter Property="Background" Value="#1E293B"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="#334155"/>
                                        <Setter Property="Background" Value="#0F172A"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,8" CornerRadius="6"
                                        Background="#0F172A" BorderThickness="1" BorderBrush="#1E293B">
                                    <StackPanel>
                                        <!-- Header Row: Timestamp + Open Badge -->
                                        <Grid Margin="0,0,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}" 
                                                       Foreground="#00F0FF" FontSize="13" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="1" Text="OPEN (DISPLAYED)" Foreground="#00F0FF" FontSize="9" FontWeight="Bold"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                        
                                        <!-- Date Row -->
                                        <TextBlock Text="{Binding Timestamp, StringFormat={}{0:yyyy-MM-dd}}" 
                                                   Foreground="#475569" FontSize="10" Margin="0,0,0,6"/>

                                        <!-- Telemetry Grid: kV, Watt, ms -->
                                        <UniformGrid Columns="3" Margin="0,0,0,8">
                                            <StackPanel HorizontalAlignment="Left">
                                                <TextBlock Text="kV" Foreground="#64748B" FontSize="9" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Voltage, StringFormat={}{0:F0}}" 
                                                           Foreground="#FFFFFF" FontSize="13" FontWeight="Bold"/>
                                            </StackPanel>
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="W" Foreground="#64748B" FontSize="9" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding PowerW, StringFormat={}{0:F0}}"
                                                           Foreground="#FFFFFF" FontSize="13" FontWeight="Bold"/>
                                            </StackPanel>
                                            <StackPanel HorizontalAlignment="Right">
                                                <TextBlock Text="ms" Foreground="#64748B" FontSize="9" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding ExposureTime, StringFormat={}{0:F0}}" 
                                                           Foreground="#FFFFFF" FontSize="13" FontWeight="Bold"/>
                                            </StackPanel>
                                        </UniformGrid>
                                        
                                        <!-- Action Buttons Row -->
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- Karşılaştırmaya Ekle (+ / ✓) -->
                                            <Button Grid.Column="0" x:Name="AddToCompBtn"
                                                    Click="AddToComparison_Click"
                                                    Width="28" Height="26"
                                                    Margin="0,0,4,0" Cursor="Hand"
                                                    ToolTip="Add to comparison">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" CornerRadius="4"
                                                                Background="#1E293B" BorderBrush="#334155" BorderThickness="1">
                                                            <TextBlock x:Name="BtnText" Text="+" Foreground="#00F0FF"
                                                                       FontSize="14" FontWeight="Bold"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="#0F172A"/>
                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#00F0FF"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <!-- Gezginde Aç -->
                                            <Button Grid.Column="1" Content="EXPLORER"
                                                    Click="OpenSingleFileInExplorer_Click"
                                                    Background="#1E293B" Foreground="#94A3B8" BorderThickness="1" BorderBrush="#334155"
                                                    FontSize="10" Height="26" Margin="0,0,3,0" Cursor="Hand" ToolTip="Open file location">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="#0F172A"/>
                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#475569"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <!-- Farklı Kaydet -->
                                            <Button Grid.Column="2" Content="EXPORT"
                                                    Click="ExportSingleFile_Click"
                                                    Background="#1E293B" Foreground="#00F0FF" BorderThickness="1" BorderBrush="#334155"
                                                    FontSize="10" Height="26" Margin="3,0,0,0" Cursor="Hand" ToolTip="Export image">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="#0F172A"/>
                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#00F0FF"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════════ COMPARISON SELECTION BAR ══════════════ -->
        <Border x:Name="ComparisonBar" Grid.Row="3" 
                Background="#0F172A" BorderBrush="#00F0FF" BorderThickness="0,1,0,0"
                Padding="12,10" Margin="0,0,0,0"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Thumbnail strip -->
                <StackPanel x:Name="ComparisonThumbStrip" Grid.Column="0"
                            Orientation="Horizontal" VerticalAlignment="Center"/>

                <!-- Action buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button Content="COMPARE SELECTED"
                            Click="OpenComparison_Click"
                            Height="38" Padding="18,0"
                            Background="#00F0FF" Foreground="#0B0F19"
                            BorderThickness="0" FontSize="12" FontWeight="Bold" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#5CFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="CLEAR"
                            Click="ClearComparison_Click"
                            Height="38" Padding="14,0" Margin="8,0,0,0"
                            Background="#1A0808" Foreground="#EF4444" 
                            BorderBrush="#3D1515" BorderThickness="1" FontSize="12" FontWeight="Bold" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" 
                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="5">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#2D1515"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- STATUS BAR -->
        <Grid Grid.Row="2" Margin="10,10,10,0">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="10" Height="10" Margin="0,0,10,0" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#FF3B30"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                    <Setter Property="Fill" Value="#00F0FF"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="SYSTEM STATUS:" Foreground="#64748B" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding DeviceStatus, FallbackValue=DISCONNECTED}" Foreground="#FFFFFF" FontSize="12" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                <TextBlock Text="X-RAY:" Foreground="#64748B" FontSize="12" Margin="28,0,0,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding XRayHardwareStateText}"
                           AutomationProperties.AutomationId="VerifiedXRayStateText"
                           Foreground="{Binding XRayHardwareStateColor}"
                           FontSize="12"
                           FontWeight="Bold"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding GeneratorHardwareStateText}" Foreground="#A7B6C9" FontSize="11" Margin="24,0,0,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding DetectorHardwareStateText}" Foreground="#A7B6C9" FontSize="11" Margin="16,0,0,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding AcquisitionCoordinatorStateText}"
                           AutomationProperties.AutomationId="AcquisitionCoordinatorStateText"
                           Foreground="#A7B6C9"
                           FontSize="11"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
