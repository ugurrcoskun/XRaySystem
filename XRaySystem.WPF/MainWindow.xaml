<Window x:Class="XRaySystem.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CMOS X-Ray Telemetry System" Height="800" Width="1300"
        Background="#0B0F19"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen"
        PreviewMouseDown="Window_PreviewMouseDown">

    <Window.Resources>
        <Style x:Key="ModernInputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="IBeam"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#00F0FF"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                    <Setter Property="Background" Value="#0F172A"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#475569"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ValidationInputTextBoxStyle" BasedOn="{StaticResource ModernInputTextBoxStyle}" TargetType="TextBox">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ExposureTimeIsValid}" Value="False">
                    <Setter Property="BorderBrush" Value="#FF3B30"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="#131A2A"/>
            <Setter Property="BorderBrush" Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="10"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#00F0FF"/> 
            <Setter Property="Foreground" Value="#0B0F19"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="25,15"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#5CFFFF"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#1E293B"/>
                    <Setter Property="Foreground" Value="#64748B"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#FF3B30"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF6B63"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#1E293B"/>
                    <Setter Property="Foreground" Value="#64748B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MetricLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="MetricValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="FontWeight" Value="Light"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>

        <!-- Modern Ultra-Sleek Dark ScrollBar Style (Kötü duran gri kutuyu kaldırır) -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Bg" Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb Background="#334155">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="2.5"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Focusable="True" FocusVisualStyle="{x:Null}" Background="Transparent" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <!-- Comparison selection bar -->
            <RowDefinition x:Name="CompBarRow" Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="10,0,10,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Orientation="Vertical">
                <TextBlock Text="X-RAY VISION CORE" Foreground="#FFFFFF" FontSize="28" FontWeight="Bold"/>
                <TextBlock Text="INDUSTRIAL CMOS SENSOR TELEMETRY" Foreground="#00F0FF" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,0"/>
            </StackPanel>
                     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding SnapCommand}" Margin="0,0,10,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                            <Setter Property="Background" Value="#FF9500"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Setter Property="Content" Value="SNAP (HI-RES)"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSnapping}" Value="True">
                                    <Setter Property="Content" Value="SNAPPING..."/>
                                    <Setter Property="Background" Value="#FFD60A"/>
                                    <Setter Property="Foreground" Value="#000000"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Command="{Binding ResumeLiveCommand}" Margin="0,0,10,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                            <Setter Property="Background" Value="#32D74B"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Setter Property="Content" Value="RESUME LIVE"/>
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                
                <Button Command="{Binding ConnectAndStartCommand}" Margin="0,0,10,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                            <Setter Property="Content" Value="CONNECT &amp; CAPTURE"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnecting}" Value="True">
                                    <Setter Property="Content" Value="CONNECTING..."/>
                                    <Setter Property="Background" Value="#1E293B"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="STOP STREAM" Command="{Binding StopCommand}" Style="{StaticResource DangerButtonStyle}" Margin="0,0,10,0"/>
                <Button Content="DISCONNECT" Command="{Binding DisconnectCommand}" Style="{StaticResource DangerButtonStyle}"/>
            </StackPanel>
        </Grid>

        <!-- CONTENT -->
        <Grid x:Name="ContentGrid" Grid.Row="1">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="0"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="270"/>
            </Grid.ColumnDefinitions>

            <!-- SOL PANEL: Metrikler ve Kullanıcı Parametre Girdileri -->
            <Grid x:Name="TelemetryPanel" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Canlı Metrikler -->
                <UniformGrid Grid.Row="0" Columns="2">
                    <Border Style="{StaticResource PanelStyle}" Margin="0,0,5,10">
                        <StackPanel>
                            <TextBlock Text="TUBE CURRENT" Style="{StaticResource MetricLabelStyle}"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                <TextBlock Text="{Binding LatestTelemetry.TubeCurrent, StringFormat={}{0:F2}, FallbackValue=0.00}" Style="{StaticResource MetricValueStyle}"/>
                                <TextBlock Text=" mA" Foreground="#64748B" FontSize="16" VerticalAlignment="Bottom" Margin="5,0,0,5"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PanelStyle}" Margin="5,0,0,10">
                        <StackPanel>
                            <TextBlock Text="TUBE VOLTAGE" Style="{StaticResource MetricLabelStyle}"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                <TextBlock Text="{Binding LatestTelemetry.Voltage, StringFormat={}{0:F2}, FallbackValue=0.00}" Style="{StaticResource MetricValueStyle}"/>
                                <TextBlock Text=" kV" Foreground="#64748B" FontSize="16" VerticalAlignment="Bottom" Margin="5,0,0,5"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PanelStyle}" Margin="0,0,5,10">
                        <StackPanel>
                            <TextBlock Text="INTENSITY" Style="{StaticResource MetricLabelStyle}"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                <TextBlock Text="{Binding LatestTelemetry.XRayIntensity, StringFormat={}{0:N0}, FallbackValue=0}" Style="{StaticResource MetricValueStyle}" Foreground="#00F0FF"/>
                                <TextBlock Text=" B" Foreground="#64748B" FontSize="16" VerticalAlignment="Bottom" Margin="5,0,0,5"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PanelStyle}" Margin="5,0,0,10">
                        <StackPanel>
                            <TextBlock Text="EXPOSURE" Style="{StaticResource MetricLabelStyle}"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                <TextBlock Text="{Binding LatestTelemetry.ExposureTime, StringFormat={}{0:F1}, FallbackValue=0.0}" Style="{StaticResource MetricValueStyle}"/>
                                <TextBlock Text=" ms" Foreground="#64748B" FontSize="16" VerticalAlignment="Bottom" Margin="5,0,0,5"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </UniformGrid>


                <!-- KULLANICI PARAMETRE GİRDİLERİ (X-RAY TUBE INPUTS) -->
                <Border Grid.Row="1" Style="{StaticResource PanelStyle}" Margin="0,0,0,10" Padding="16">
                    <StackPanel>
                        <TextBlock Text="TÜP PARAMETRE GİRDİLERİ" Foreground="#00F0FF" FontSize="14" FontWeight="Bold" Margin="0,0,0,14"/>
                        
                        <!-- TUBE VOLTAGE (kV) INPUT -->
                        <TextBlock Text="TÜP VOLTAJI (kV):" Foreground="#64748B" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding UserVoltage, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource ModernInputTextBoxStyle}"/>
                            <TextBlock Grid.Column="1" Text="kV" Foreground="#94A3B8" FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>

                        <!-- TUBE CURRENT (mA) INPUT -->
                        <TextBlock Text="TÜP AKIMI (mA):" Foreground="#64748B" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding UserTubeCurrent, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource ModernInputTextBoxStyle}"/>
                            <TextBlock Grid.Column="1" Text="mA" Foreground="#94A3B8" FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>

                        <!-- EXPOSURE TIME (ms) INPUT -->
                        <TextBlock Text="POZLAMA SÜRESİ (ms):" Foreground="#64748B" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding UserExposureTime, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource ValidationInputTextBoxStyle}"/>
                            <TextBlock Grid.Column="1" Text="ms" Foreground="#94A3B8" FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>

                        <TextBlock Text="{Binding ExposureValidationMessage}" FontSize="10" Margin="0,2,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#64748B"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ExposureTimeIsValid}" Value="False">
                                            <Setter Property="Foreground" Value="#FF3B30"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ORTA PANEL: Canlı Görüntü Matrisi -->
            <Border x:Name="ScanPanel" Grid.Column="1" Style="{StaticResource PanelStyle}" Margin="10,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Text="LIVE X-RAY SCAN MATRIX" Style="{StaticResource MetricLabelStyle}"/>
                    
                    <Border x:Name="XRayScanBorder" Grid.Row="1" BorderBrush="#334155" BorderThickness="1" Margin="0,15,0,0" CornerRadius="4" Background="#02040A" ClipToBounds="True"
                            MouseWheel="XRayImage_MouseWheel"
                            MouseLeftButtonDown="XRayImage_MouseLeftButtonDown"
                            MouseLeftButtonUp="XRayImage_MouseLeftButtonUp"
                            MouseMove="XRayImage_MouseMove"
                            LostMouseCapture="XRayImage_LostMouseCapture"
                            Cursor="Cross">
                        <Grid x:Name="XRayContainer" Background="Transparent">
                            <!-- Only this layer is transformed; all HUD/control content remains viewport-fixed. -->
                            <Grid x:Name="ImageLayer" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                              <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="XRayScaleTransform" ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform x:Name="XRayTranslateTransform" X="0" Y="0"/>
                                </TransformGroup>
                              </Grid.RenderTransform>
                              <Image x:Name="XRayImage" Source="{Binding CurrentFrame}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                              <Path Data="M 150,0 L 150,300 M 0,150 L 300,150" Stroke="#00F0FF" StrokeThickness="0.5" Opacity="0.3" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform"/>
                            </Grid>
                             
                            <!-- Viewport HUD: deliberately outside ImageLayer. -->
                            <Grid>
                                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="15" IsHitTestVisible="False">
                                    <TextBlock Text="FOV: 24x30 cm" Foreground="#00F0FF" FontSize="12" Opacity="0.7"/>
                                    <TextBlock Text="RES: 2304x2930" Foreground="#00F0FF" FontSize="12" Opacity="0.7"/>
                                </StackPanel>

                                <!-- CANLI / SNAP / GEÇMİŞ İNCELEME STATUS ROZETİ (Görsel durum belirteci) -->
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="15" 
                                        Background="#0F172A" BorderBrush="{Binding ImageStatusBadgeColor}" BorderThickness="1.5"
                                        CornerRadius="6" Padding="12,6" IsHitTestVisible="False">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="10" Height="10" Fill="{Binding ImageStatusBadgeColor}" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding ImageStatusBadgeText}" 
                                                   Foreground="#FFFFFF" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Zoom controls at bottom-left inside image viewport -->
                                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="15" Orientation="Horizontal">
                                    <Button Content="+" Width="30" Height="30" Background="#1E293B" Foreground="White" BorderThickness="1" BorderBrush="#334155" Margin="0,0,5,0" Cursor="Hand" Click="ZoomIn_Click"/>
                                    <Button Content="-" Width="30" Height="30" Background="#1E293B" Foreground="White" BorderThickness="1" BorderBrush="#334155" Margin="0,0,5,0" Cursor="Hand" Click="ZoomOut_Click"/>
                                    <Button Content="RESET" Height="30" Padding="10,0" Background="#1E293B" Foreground="White" BorderThickness="1" BorderBrush="#334155" Cursor="Hand" Click="ZoomReset_Click"/>
                                    <TextBlock x:Name="ZoomPercentText" Text="100%" Foreground="#FFFFFF" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>

                                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="15" IsHitTestVisible="False">
                                    <TextBlock Text="{Binding LatestTelemetry.Timestamp, StringFormat={}{0:yyyy-MM-dd HH:mm:ss.fff}}" Foreground="#00F0FF" FontSize="14" Opacity="0.8" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- SAĞ PANEL: Görsel Geçmişi (Image History) -->
            <Border x:Name="HistoryPanel" Grid.Column="2" Style="{StaticResource PanelStyle}" Margin="10,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Başlık, İpucu ve Klasör Butonu -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="IMAGE HISTORY" Foreground="#00F0FF" FontSize="13" FontWeight="Bold"/>
                        <TextBlock Text="Snap çekim geçmişi" Foreground="#475569" FontSize="10" Margin="0,1,0,0"/>
                        <TextBlock x:Name="CompSelectionHint" 
                                   Text="+ butonuna basarak karşılaştırma için görsel seçin (maks 4)"
                                   Foreground="#64748B" FontSize="9.5" TextWrapping="Wrap" Margin="0,4,0,8"/>
                        
                        <!-- Klasör Aç Butonu: Projenin Standart Cyan Paleti -->
                        <Button Content="📁 KLASÖRÜ AÇ" 
                                Click="OpenImageFolder_Click" 
                                Background="#1E293B" Foreground="#00F0FF" BorderBrush="#334155" BorderThickness="1"
                                FontSize="11" FontWeight="Bold" Height="30" Cursor="Hand" HorizontalAlignment="Stretch">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#0F172A"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#00F0FF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <!-- Liste -->
                    <ListBox x:Name="ImageHistoryListBox"
                             Grid.Row="1"
                             ItemsSource="{Binding ImageHistory}"
                             Background="Transparent"
                             BorderThickness="0"
                             SelectionChanged="ImageHistoryListBox_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="BorderBrush" Value="#00F0FF"/>
                                        <Setter Property="Background" Value="#1E293B"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="#334155"/>
                                        <Setter Property="Background" Value="#0F172A"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,8" CornerRadius="6"
                                        Background="#0F172A" BorderThickness="1" BorderBrush="#1E293B">
                                    <StackPanel>
                                        <!-- Header Row: Timestamp + Open Badge -->
                                        <Grid Margin="0,0,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}" 
                                                       Foreground="#00F0FF" FontSize="13" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="1" Text="AÇIK (EKRANDA)" Foreground="#00F0FF" FontSize="9" FontWeight="Bold" 
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                        
                                        <!-- Date Row -->
                                        <TextBlock Text="{Binding Timestamp, StringFormat={}{0:yyyy-MM-dd}}" 
                                                   Foreground="#475569" FontSize="10" Margin="0,0,0,6"/>

                                        <!-- Telemetry Grid: kV, mA, ms -->
                                        <UniformGrid Columns="3" Margin="0,0,0,8">
                                            <StackPanel HorizontalAlignment="Left">
                                                <TextBlock Text="kV" Foreground="#64748B" FontSize="9" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Voltage, StringFormat={}{0:F0}}" 
                                                           Foreground="#FFFFFF" FontSize="13" FontWeight="Bold"/>
                                            </StackPanel>
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="mA" Foreground="#64748B" FontSize="9" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding TubeCurrent, StringFormat={}{0:F0}}" 
                                                           Foreground="#FFFFFF" FontSize="13" FontWeight="Bold"/>
                                            </StackPanel>
                                            <StackPanel HorizontalAlignment="Right">
                                                <TextBlock Text="ms" Foreground="#64748B" FontSize="9" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding ExposureTime, StringFormat={}{0:F0}}" 
                                                           Foreground="#FFFFFF" FontSize="13" FontWeight="Bold"/>
                                            </StackPanel>
                                        </UniformGrid>
                                        
                                        <!-- Action Buttons Row -->
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- Karşılaştırmaya Ekle (+ / ✓) -->
                                            <Button Grid.Column="0" x:Name="AddToCompBtn"
                                                    Click="AddToComparison_Click"
                                                    Width="28" Height="26"
                                                    Margin="0,0,4,0" Cursor="Hand"
                                                    ToolTip="Karşılaştırmaya Ekle">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" CornerRadius="4"
                                                                Background="#1E293B" BorderBrush="#334155" BorderThickness="1">
                                                            <TextBlock x:Name="BtnText" Text="+" Foreground="#00F0FF"
                                                                       FontSize="14" FontWeight="Bold"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="#0F172A"/>
                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#00F0FF"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <!-- Gezginde Aç -->
                                            <Button Grid.Column="1" Content="📁 Gezgin" 
                                                    Click="OpenSingleFileInExplorer_Click"
                                                    Background="#1E293B" Foreground="#94A3B8" BorderThickness="1" BorderBrush="#334155"
                                                    FontSize="10" Height="26" Margin="0,0,3,0" Cursor="Hand" ToolTip="Dosya konumunu aç">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="#0F172A"/>
                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#475569"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <!-- Farklı Kaydet -->
                                            <Button Grid.Column="2" Content="💾 Kaydet" 
                                                    Click="ExportSingleFile_Click"
                                                    Background="#1E293B" Foreground="#00F0FF" BorderThickness="1" BorderBrush="#334155"
                                                    FontSize="10" Height="26" Margin="3,0,0,0" Cursor="Hand" ToolTip="Dışa kaydet">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="#0F172A"/>
                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#00F0FF"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════════ COMPARISON SELECTION BAR ══════════════ -->
        <Border x:Name="ComparisonBar" Grid.Row="3" 
                Background="#080F1E" BorderBrush="#00AAFF" BorderThickness="0,1,0,0"
                Padding="12,10" Margin="0,0,0,0"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Thumbnail strip -->
                <StackPanel x:Name="ComparisonThumbStrip" Grid.Column="0"
                            Orientation="Horizontal" VerticalAlignment="Center"/>

                <!-- Action buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button Content="⬡  SEÇİLENLERİ KARŞILAŞTIR" 
                            Click="OpenComparison_Click"
                            Height="38" Padding="18,0"
                            Background="#00AAFF" Foreground="#060910" 
                            BorderThickness="0" FontSize="12" FontWeight="Bold" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#33CCFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="✕ TEMİZLE" 
                            Click="ClearComparison_Click"
                            Height="38" Padding="14,0" Margin="8,0,0,0"
                            Background="#1A0808" Foreground="#EF4444" 
                            BorderBrush="#3D1515" BorderThickness="1" FontSize="12" FontWeight="Bold" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" 
                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="5">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#2D1515"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- STATUS BAR -->
        <Grid Grid.Row="2" Margin="10,10,10,0">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="10" Height="10" Margin="0,0,10,0" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#FF3B30"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                    <Setter Property="Fill" Value="#00F0FF"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="SYSTEM STATUS:" Foreground="#64748B" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding DeviceStatus, FallbackValue=DISCONNECTED}" Foreground="#FFFFFF" FontSize="12" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
