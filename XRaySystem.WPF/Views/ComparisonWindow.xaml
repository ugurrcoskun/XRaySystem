<Window x:Class="XRaySystem.WPF.Views.ComparisonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="X-RAY COMPARISON VIEWER" 
        Background="#060910"
        FontFamily="Segoe UI"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- Ruler tick label style -->
        <Style x:Key="RulerTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#3A5270"/>
            <Setter Property="FontSize" Value="8"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>

        <!-- Thin scrollbar -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb Background="#1E3A5F">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top toolbar -->
            <RowDefinition Height="52"/>
            <!-- Comparison panels -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══════════════ TOOLBAR ══════════════ -->
        <Border Grid.Row="0" Background="#0B1120" BorderBrush="#0F2040" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: title + image count -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,30,0">
                    <TextBlock Text="⬡" Foreground="#00AAFF" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="COMPARISON VIEWER" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold"/>
                        <TextBlock x:Name="ImageCountLabel" Text="" Foreground="#334F72" FontSize="10" Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Center: Zoom controls -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="ZOOM" Foreground="#334F72" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button x:Name="ZoomOutBtn" Content="−" Width="32" Height="32" Background="#0F1E35" Foreground="#00AAFF" 
                            BorderBrush="#0F2A4A" BorderThickness="1" FontSize="16" Cursor="Hand"
                            Click="ZoomOut_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" 
                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="4">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#1A3050"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Border Background="#0B1525" BorderBrush="#0F2A4A" BorderThickness="1" CornerRadius="4" Margin="6,0" Padding="16,0">
                        <TextBlock x:Name="ZoomLabel" Text="100%" Foreground="#00AAFF" FontSize="14" FontWeight="Bold"
                                   FontFamily="Consolas" VerticalAlignment="Center" MinWidth="52" TextAlignment="Center"/>
                    </Border>
                    <Button x:Name="ZoomInBtn" Content="+" Width="32" Height="32" Background="#0F1E35" Foreground="#00AAFF" 
                            BorderBrush="#0F2A4A" BorderThickness="1" FontSize="16" Cursor="Hand"
                            Click="ZoomIn_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="4">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#1A3050"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="RESET" Height="32" Padding="14,0" Background="#0F1E35" Foreground="#64748B" 
                            BorderBrush="#0F2A4A" BorderThickness="1" FontSize="11" FontWeight="SemiBold" Cursor="Hand"
                            Margin="6,0,0,0" Click="ZoomReset_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="4">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#1A3050"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <!-- Right: close -->
                <Button Grid.Column="2" Content="✕  KAPAT" Height="34" Padding="16,0"
                        Background="#0F1E35" Foreground="#EF4444" BorderBrush="#2D1515" BorderThickness="1"
                        FontSize="12" FontWeight="Bold" Cursor="Hand" Click="CloseBtn_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#2D1515"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- ══════════════ COMPARISON PANELS ══════════════ -->
        <!-- Built dynamically in code-behind based on image count -->
        <Grid x:Name="ComparisonGrid" Grid.Row="1" Background="#060910"/>

    </Grid>
</Window>
