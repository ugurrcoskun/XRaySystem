<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dto="clr-namespace:XRaySystem.Application.DTOs;assembly=XRaySystem.Application"
    xmlns:vm="clr-namespace:XRaySystem.Mobile.ViewModels"
    x:Class="XRaySystem.Mobile.MainPage"
    x:Name="PageRoot"
    x:DataType="vm:MainViewModel"
    Title="X-Ray Vision Mobile"
    Shell.NavBarIsVisible="False">

    <Grid>
    <ScrollView x:Name="PageScrollView"
                Orientation="Vertical"
                VerticalScrollBarVisibility="Default">
        <VerticalStackLayout Padding="{OnPlatform Android='16,22,16,30', iOS='18,12,18,32', MacCatalyst='28', WinUI='28'}"
                             Spacing="16"
                             MaximumWidthRequest="1440">

            <!-- Marka ve bağlantı durumu -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                    <Label Text="X-RAY VISION"
                           FontFamily="OpenSansSemibold"
                           FontSize="22"
                           CharacterSpacing="1.2" />
                    <Label Text="MOBILE SENSOR CONSOLE"
                           Style="{StaticResource EyebrowLabelStyle}" />
                </VerticalStackLayout>

                <Border Grid.Column="1"
                        Padding="12,7"
                        VerticalOptions="Center"
                        BackgroundColor="{Binding StatusBadgeBackground}"
                        Stroke="{Binding StatusAccentColor}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20">
                    <HorizontalStackLayout Spacing="7">
                        <Label Text="●"
                               TextColor="{Binding StatusAccentColor}"
                               FontSize="11"
                               VerticalTextAlignment="Center" />
                        <Label Text="{Binding StatusDisplayText}"
                               FontFamily="OpenSansSemibold"
                               FontSize="10"
                               CharacterSpacing="0.8"
                               VerticalTextAlignment="Center" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>

            <Border Style="{StaticResource SoftCardStyle}"
                    Stroke="{Binding StatusAccentColor}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                        <Label Text="SİSTEM DURUMU" Style="{StaticResource CaptionLabelStyle}" />
                        <Label Text="{Binding StatusMessage}"
                               TextColor="{StaticResource TextSecondary}"
                               FontSize="12"
                               LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>
                    <ActivityIndicator Grid.Column="1"
                                       IsRunning="{Binding IsBusy}"
                                       IsVisible="{Binding IsBusy}"
                                       WidthRequest="24"
                                       HeightRequest="24" />
                </Grid>
            </Border>

            <!-- Telefonda dikey, tablet/desktop genişliğinde iki kolon -->
            <Grid x:Name="Workspace"
                  RowDefinitions="Auto,Auto"
                  ColumnDefinitions="*"
                  RowSpacing="16"
                  ColumnSpacing="16">

                <!-- Görüntüleyici -->
                <VerticalStackLayout x:Name="ViewerPanel" Grid.Row="0" Spacing="12">
                    <Border Style="{StaticResource CardStyle}" Padding="12">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
                            <Grid ColumnDefinitions="*,Auto" Padding="4,2">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="LIVE X-RAY MATRIX" Style="{StaticResource EyebrowLabelStyle}" />
                                    <Label Text="Gray16 görüntü alanı" Style="{StaticResource SectionTitleStyle}" />
                                </VerticalStackLayout>
                                <Border Grid.Column="1"
                                        Padding="10,6"
                                        BackgroundColor="{Binding StatusBadgeBackground}"
                                        Stroke="{Binding StatusAccentColor}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 14"
                                        VerticalOptions="Center">
                                    <Label Text="{Binding FrameKindDisplay}"
                                           TextColor="{Binding StatusAccentColor}"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="9"
                                           CharacterSpacing="0.8" />
                                </Border>
                            </Grid>

                            <Border Grid.Row="1"
                                    HeightRequest="390"
                                    MinimumHeightRequest="300"
                                    Padding="0"
                                    BackgroundColor="{StaticResource ViewerBackground}"
                                    Stroke="{StaticResource StrokeStrong}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 12">
                                <Grid x:Name="ImageViewport"
                                      IsClippedToBounds="True">
                                    <BoxView Color="#07111F" Opacity="0.42" />
                                    <Grid Opacity="0.16" InputTransparent="True">
                                        <BoxView WidthRequest="1" Color="{StaticResource Primary}" HorizontalOptions="Center" />
                                        <BoxView HeightRequest="1" Color="{StaticResource Primary}" VerticalOptions="Center" />
                                        <Border WidthRequest="210" HeightRequest="210"
                                                BackgroundColor="Transparent"
                                                Stroke="{StaticResource Primary}"
                                                StrokeThickness="1"
                                                StrokeShape="RoundRectangle 105"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center" />
                                    </Grid>

                                    <Image x:Name="SensorImage"
                                           Source="{Binding CurrentImage}"
                                           AutomationId="SensorImage"
                                           SemanticProperties.Description="Canlı veya kaydedilmiş X-ray sensör görüntüsü"
                                           Aspect="AspectFit"
                                           IsVisible="{Binding HasCurrentImage}">
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnOpenFullScreenTapped" />
                                            <PinchGestureRecognizer PinchUpdated="OnImagePinchUpdated" />
                                            <PanGestureRecognizer x:Name="ImagePanGesture"
                                                                  TouchPoints="1"
                                                                  PanUpdated="OnImagePanUpdated" />
                                        </Image.GestureRecognizers>
                                    </Image>

                                    <VerticalStackLayout IsVisible="{Binding HasNoCurrentImage}"
                                                         HorizontalOptions="Center"
                                                         VerticalOptions="Center"
                                                         Spacing="8">
                                        <Border WidthRequest="62" HeightRequest="62"
                                                Padding="0"
                                                BackgroundColor="#101E31"
                                                Stroke="{StaticResource StrokeStrong}"
                                                StrokeThickness="1"
                                                StrokeShape="RoundRectangle 31">
                                            <Label Text="✦"
                                                   TextColor="{StaticResource Primary}"
                                                   FontSize="27"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center" />
                                        </Border>
                                        <Label Text="SENSÖR GÖRÜNTÜSÜ BEKLENİYOR"
                                               Style="{StaticResource EyebrowLabelStyle}"
                                               HorizontalTextAlignment="Center" />
                                        <Label Text="Cihaza bağlanın ve canlı akışı başlatın"
                                               TextColor="{StaticResource TextMuted}"
                                               FontSize="12"
                                               HorizontalTextAlignment="Center" />
                                    </VerticalStackLayout>

                                    <Border Margin="12"
                                            Padding="9,6"
                                            BackgroundColor="#CC07101C"
                                            Stroke="{StaticResource Stroke}"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 10"
                                            HorizontalOptions="Start"
                                            VerticalOptions="End">
                                        <Label Text="{Binding FrameMetadataText}"
                                               TextColor="{StaticResource Primary}"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="10" />
                                    </Border>

                                </Grid>
                            </Border>

                            <Border Grid.Row="2"
                                    Padding="7"
                                    BackgroundColor="{StaticResource SurfaceSoft}"
                                    Stroke="{StaticResource Stroke}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 10"
                                    IsEnabled="{Binding HasCurrentImage}">
                                <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto"
                                      ColumnSpacing="6">
                                    <Button Text="−"
                                            AutomationId="ZoomOutButton"
                                            SemanticProperties.Description="Görüntüyü uzaklaştır"
                                            Clicked="OnZoomOutClicked"
                                            WidthRequest="42"
                                            HeightRequest="40"
                                            Padding="0"
                                            FontSize="18" />
                                    <Label Grid.Column="1"
                                           x:Name="ZoomLevelLabel"
                                           Text="100%"
                                           WidthRequest="50"
                                           TextColor="{StaticResource TextPrimary}"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="11"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center" />
                                    <Button Grid.Column="2"
                                            Text="+"
                                            AutomationId="ZoomInButton"
                                            SemanticProperties.Description="Görüntüyü yakınlaştır"
                                            Clicked="OnZoomInClicked"
                                            WidthRequest="42"
                                            HeightRequest="40"
                                            Padding="0"
                                            FontSize="16" />
                                    <Button Grid.Column="3"
                                            Text="TAM EKRAN"
                                            AutomationId="OpenFullScreenViewerButton"
                                            SemanticProperties.Description="Görüntüyü tam ekran incele"
                                            Clicked="OnOpenFullScreenClicked"
                                            HeightRequest="40"
                                            Padding="10,0"
                                            FontSize="9" />
                                    <Button Grid.Column="4"
                                            Text="SIFIRLA"
                                            AutomationId="ResetZoomButton"
                                            SemanticProperties.Description="Yakınlaştırma ve görüntü konumunu sıfırla"
                                            Clicked="OnResetZoomClicked"
                                            HeightRequest="40"
                                            Padding="10,0"
                                            FontSize="9" />
                                </Grid>
                            </Border>

                            <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Padding="4,0">
                                <Label Text="{Binding LastFrameTimeText}"
                                       TextColor="{StaticResource TextMuted}"
                                       FontSize="10"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="16-BIT · LOSSLESS SOURCE"
                                       Style="{StaticResource CaptionLabelStyle}"
                                       TextColor="{StaticResource Primary}" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Mobil Window / Level -->
                    <Border Style="{StaticResource CardStyle}">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <VerticalStackLayout Spacing="1">
                                    <Label Text="WINDOW / LEVEL" Style="{StaticResource EyebrowLabelStyle}" />
                                    <Label Text="Görüntü kontrastı" Style="{StaticResource SectionTitleStyle}" />
                                </VerticalStackLayout>
                                <Button Grid.Column="1" Text="AUTO"
                                        Command="{Binding AutoWindowLevelCommand}"
                                        Padding="12,7" MinimumHeightRequest="38" />
                                <Button Grid.Column="2" Text="RESET"
                                        Command="{Binding ResetWindowLevelCommand}"
                                        Padding="12,7" MinimumHeightRequest="38" />
                            </Grid>

                            <Grid ColumnDefinitions="58,*,58" RowDefinitions="Auto,Auto" RowSpacing="8" ColumnSpacing="8">
                                <Label Text="CENTER" Style="{StaticResource CaptionLabelStyle}" VerticalOptions="Center" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="65535"
                                        Value="{Binding WindowCenter}" />
                                <Label Grid.Column="2" Text="{Binding WindowCenter, StringFormat='{}{0:F0}'}"
                                       TextColor="{StaticResource Primary}" FontSize="11" HorizontalTextAlignment="End" />

                                <Label Grid.Row="1" Text="WIDTH" Style="{StaticResource CaptionLabelStyle}" VerticalOptions="Center" />
                                <Slider Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="65535"
                                        Value="{Binding WindowWidth}" />
                                <Label Grid.Row="1" Grid.Column="2" Text="{Binding WindowWidth, StringFormat='{}{0:F0}'}"
                                       TextColor="{StaticResource Primary}" FontSize="11" HorizontalTextAlignment="End" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Cihaz ve acquisition kontrolleri -->
                <VerticalStackLayout x:Name="ControlPanel" Grid.Row="1" Spacing="12">
                    <Border Style="{StaticResource CardStyle}">
                        <VerticalStackLayout Spacing="13">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="DEVICE LINK" Style="{StaticResource EyebrowLabelStyle}" />
                                <Label Text="Cihaz kontrolü" Style="{StaticResource SectionTitleStyle}" />
                            </VerticalStackLayout>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label Text="ÇALIŞMA MODU"
                                       Style="{StaticResource CaptionLabelStyle}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="{Binding ActiveConnectionModeText}"
                                       TextColor="{StaticResource TextSecondary}"
                                       FontSize="10"
                                       VerticalOptions="Center" />
                            </Grid>

                            <Border Padding="10,0"
                                    BackgroundColor="{StaticResource FieldBackground}"
                                    Stroke="{StaticResource Stroke}"
                                    StrokeShape="RoundRectangle 11">
                                <Picker ItemsSource="{Binding ConnectionModeOptions}"
                                        SelectedIndex="{Binding SelectedConnectionModeIndex}"
                                        AutomationId="ConnectionModePicker"
                                        SemanticProperties.Description="Yerel mock veya uzak DeviceHost çalışma modu" />
                            </Border>

                            <VerticalStackLayout Spacing="8"
                                                 IsVisible="{Binding IsRemoteConnectionMode}">
                                <Label Text="DEVICEHOST ADRESİ"
                                       Style="{StaticResource CaptionLabelStyle}" />
                                <Border Padding="10,0"
                                        BackgroundColor="{StaticResource FieldBackground}"
                                        Stroke="{StaticResource Stroke}"
                                        StrokeShape="RoundRectangle 11">
                                    <Entry Text="{Binding DeviceHostUrl}"
                                           Keyboard="Url"
                                           AutomationId="DeviceHostUrlEntry"
                                           SemanticProperties.Description="DeviceHost HTTP veya HTTPS adresi" />
                                </Border>
                                <Label Text="CİHAZ KİMLİĞİ"
                                       Style="{StaticResource CaptionLabelStyle}" />
                                <Border Padding="10,0"
                                        BackgroundColor="{StaticResource FieldBackground}"
                                        Stroke="{StaticResource Stroke}"
                                        StrokeShape="RoundRectangle 11">
                                    <Entry Text="{Binding RemoteDeviceId}"
                                           AutomationId="RemoteDeviceIdEntry"
                                           SemanticProperties.Description="Bağlanılacak uzak cihaz kimliği" />
                                </Border>
                            </VerticalStackLayout>

                            <Button Text="BAĞLANTI AYARINI KAYDET"
                                    AutomationId="SaveConnectionSettingsButton"
                                    SemanticProperties.Hint="Seçilen çalışma modunu sonraki uygulama başlangıcı için kaydeder"
                                    Command="{Binding ApplyConnectionSettingsCommand}" />

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="9">
                                <Button Text="BAĞLAN"
                                        AutomationId="ConnectButton"
                                        SemanticProperties.Hint="Seçili X-ray sensör servisine bağlanır"
                                        Command="{Binding ConnectCommand}"
                                        Style="{StaticResource PrimaryActionButton}" />
                                <Button Grid.Column="1" Text="BAĞLANTIYI KES"
                                        AutomationId="DisconnectButton"
                                        SemanticProperties.Hint="Aktif sensör bağlantısını güvenli şekilde kapatır"
                                        Command="{Binding DisconnectCommand}"
                                        Style="{StaticResource DangerActionButton}" />
                            </Grid>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="9">
                                <Button Text="{Binding StartLiveActionText}"
                                        AutomationId="StartLiveButton"
                                        SemanticProperties.Description="Canlı görüntü akışını başlat"
                                        Command="{Binding StartLiveCommand}"
                                        Style="{StaticResource SuccessActionButton}" />
                                <Button Grid.Column="1" Text="■  DURDUR"
                                        AutomationId="StopLiveButton"
                                        SemanticProperties.Description="Canlı akışı veya çekimi durdur"
                                        Command="{Binding StopLiveCommand}"
                                        Style="{StaticResource DangerActionButton}" />
                            </Grid>

                            <Button Text="●  SNAP ÇEK"
                                    AutomationId="SnapButton"
                                    SemanticProperties.Hint="Girilen kV, Watt ve pozlama süresiyle yüksek çözünürlüklü görüntü alır"
                                    Command="{Binding SnapCommand}"
                                    Style="{StaticResource SnapActionButton}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <VerticalStackLayout Spacing="13">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="ACQUISITION" Style="{StaticResource EyebrowLabelStyle}" />
                                    <Label Text="Tüp parametreleri" Style="{StaticResource SectionTitleStyle}" />
                                </VerticalStackLayout>
                                <Button Grid.Column="1" Text="VARSAYILAN"
                                        Command="{Binding ResetParametersCommand}"
                                        Padding="10,6" MinimumHeightRequest="36" FontSize="9" />
                            </Grid>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="9">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="TÜP VOLTAJI" Style="{StaticResource CaptionLabelStyle}" />
                                    <Border Padding="11,0" BackgroundColor="{StaticResource FieldBackground}"
                                            Stroke="{StaticResource Stroke}" StrokeShape="RoundRectangle 11">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Entry Text="{Binding Kv}" Keyboard="Numeric" ReturnType="Next"
                                                   AutomationId="VoltageEntry"
                                                   SemanticProperties.Description="Tüp voltajı, kilovolt" />
                                            <Label Grid.Column="1" Text="kV" TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
                                        </Grid>
                                    </Border>
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1" Spacing="6">
                                    <Label Text="TÜP GÜCÜ" Style="{StaticResource CaptionLabelStyle}" />
                                    <Border Padding="11,0" BackgroundColor="{StaticResource FieldBackground}"
                                            Stroke="{StaticResource Stroke}" StrokeShape="RoundRectangle 11">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Entry Text="{Binding Watt}" Keyboard="Numeric" ReturnType="Next"
                                                   AutomationId="PowerEntry"
                                                   SemanticProperties.Description="Tüp gücü, Watt" />
                                            <Label Grid.Column="1" Text="W" TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
                                        </Grid>
                                    </Border>
                                </VerticalStackLayout>
                            </Grid>

                            <VerticalStackLayout Spacing="6">
                                <Label Text="POZLAMA SÜRESİ" Style="{StaticResource CaptionLabelStyle}" />
                                <Border Padding="11,0" BackgroundColor="{StaticResource FieldBackground}"
                                        Stroke="{Binding ParametersAccentColor}" StrokeShape="RoundRectangle 11">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Entry Text="{Binding ExposureTime}" Keyboard="Numeric" ReturnType="Done"
                                               AutomationId="ExposureEntry"
                                               SemanticProperties.Description="Pozlama süresi, milisaniye" />
                                        <Label Grid.Column="1" Text="ms" TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>

                            <Label Text="{Binding ParametersValidationMessage}"
                                   TextColor="{Binding ParametersAccentColor}"
                                   FontSize="10"
                                   LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Grid>

            <!-- Son sensör ölçümleri -->
            <VerticalStackLayout Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="LIVE TELEMETRY" Style="{StaticResource EyebrowLabelStyle}" />
                        <Label Text="Son sensör ölçümü" Style="{StaticResource SectionTitleStyle}" />
                    </VerticalStackLayout>
                    <Label Grid.Column="1" Text="{Binding LastFrameTimeText}"
                           TextColor="{StaticResource TextMuted}" FontSize="10" VerticalOptions="End" />
                </Grid>

                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                    <Border Style="{StaticResource SoftCardStyle}">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="TUBE POWER" Style="{StaticResource CaptionLabelStyle}" />
                            <HorizontalStackLayout Spacing="5">
                                <Label Text="{Binding MeasuredPowerW, StringFormat='{}{0:F1}'}" Style="{StaticResource MetricValueStyle}" />
                                <Label Text="W" TextColor="{StaticResource TextMuted}" VerticalOptions="End" Margin="0,0,0,4" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource SoftCardStyle}">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="TUBE VOLTAGE" Style="{StaticResource CaptionLabelStyle}" />
                            <HorizontalStackLayout Spacing="5">
                                <Label Text="{Binding MeasuredVoltageKv, StringFormat='{}{0:F1}'}" Style="{StaticResource MetricValueStyle}" />
                                <Label Text="kV" TextColor="{StaticResource TextMuted}" VerticalOptions="End" Margin="0,0,0,4" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource SoftCardStyle}">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="EXPOSURE" Style="{StaticResource CaptionLabelStyle}" />
                            <HorizontalStackLayout Spacing="5">
                                <Label Text="{Binding MeasuredExposureMs, StringFormat='{}{0:F0}'}" Style="{StaticResource MetricValueStyle}" />
                                <Label Text="ms" TextColor="{StaticResource TextMuted}" VerticalOptions="End" Margin="0,0,0,4" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource SoftCardStyle}">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="INTENSITY" Style="{StaticResource CaptionLabelStyle}" />
                            <HorizontalStackLayout Spacing="5">
                                <Label Text="{Binding MeasuredIntensity, StringFormat='{}{0:F0}'}"
                                       Style="{StaticResource MetricValueStyle}"
                                       TextColor="{StaticResource Primary}" />
                                <Label Text="B" TextColor="{StaticResource TextMuted}" VerticalOptions="End" Margin="0,0,0,4" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </VerticalStackLayout>

            <!-- Mobil yerel görüntü geçmişi -->
            <Border Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="LOCAL HISTORY" Style="{StaticResource EyebrowLabelStyle}" />
                            <Label Text="Son mobil çekimler" Style="{StaticResource SectionTitleStyle}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1"
                                Text="YENİLE"
                                Command="{Binding RefreshHistoryCommand}"
                                Padding="12,7"
                                MinimumHeightRequest="38" />
                    </Grid>

                    <Grid IsVisible="{Binding HasNoRecentImages}" HeightRequest="92">
                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="5">
                            <Label Text="◇" TextColor="{StaticResource TextMuted}" FontSize="24" HorizontalTextAlignment="Center" />
                            <Label Text="Henüz kaydedilmiş mobil snap yok"
                                   TextColor="{StaticResource TextMuted}"
                                   FontSize="11"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Grid>

                    <FlexLayout BindableLayout.ItemsSource="{Binding RecentImages}"
                                IsVisible="{Binding HasRecentImages}"
                                Direction="Row"
                                Wrap="Wrap"
                                JustifyContent="Start"
                                AlignItems="Start">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="dto:SensorDataDto">
                                <Border WidthRequest="218"
                                        Margin="0,0,10,10"
                                        Padding="10"
                                        BackgroundColor="{StaticResource SurfaceSoft}"
                                        Stroke="{StaticResource Stroke}"
                                        StrokeShape="RoundRectangle 13"
                                        SemanticProperties.Hint="Kaydedilmiş görüntüyü tam inceleme alanında açar">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.LoadHistoryImageCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Grid RowDefinitions="88,Auto" RowSpacing="8">
                                        <Border Padding="0"
                                                BackgroundColor="{StaticResource ViewerBackground}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 9">
                                            <Image Source="{Binding ImagePath}" Aspect="AspectFill" />
                                        </Border>
                                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                                            <VerticalStackLayout Spacing="1">
                                                <Label Text="{Binding Timestamp, StringFormat='{}{0:dd.MM · HH:mm}'}"
                                                       TextColor="{StaticResource TextPrimary}"
                                                       FontFamily="OpenSansSemibold"
                                                       FontSize="11" />
                                                <Label Text="{Binding PowerW, StringFormat='{}{0:F0} W'}"
                                                       TextColor="{StaticResource Primary}"
                                                       FontSize="10" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1"
                                                   Text="İNCELE"
                                                   Style="{StaticResource CaptionLabelStyle}"
                                                   VerticalOptions="Center" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,Auto" Margin="2,8,2,0">
                <Label Text="SIMULATION MODE · NOT FOR CLINICAL USE"
                       Style="{StaticResource CaptionLabelStyle}" />
                <Label Grid.Column="1" Text="XRS MOBILE 1.1"
                       Style="{StaticResource CaptionLabelStyle}"
                       TextColor="{StaticResource Primary}" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>

        <!-- Telefonda görüntü incelemeyi sayfa ScrollView'undan ayırır. -->
        <Grid x:Name="FullScreenViewerOverlay"
              IsVisible="False"
              ZIndex="100"
              BackgroundColor="{StaticResource PageBackground}"
              RowDefinitions="Auto,*,Auto"
              AutomationId="FullScreenImageViewer">
            <Grid Padding="16,12"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="12"
                  BackgroundColor="{StaticResource Surface}">
                <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                    <Label Text="GÖRÜNTÜ İNCELEME"
                           Style="{StaticResource EyebrowLabelStyle}" />
                    <Label Text="İki parmakla yakınlaştır · tek parmakla gez"
                           TextColor="{StaticResource TextSecondary}"
                           FontSize="11" />
                </VerticalStackLayout>
                <Button Grid.Column="1"
                        Text="KAPAT"
                        Clicked="OnCloseFullScreenClicked"
                        AutomationId="CloseFullScreenViewerButton"
                        SemanticProperties.Description="Tam ekran görüntü incelemeyi kapat"
                        MinimumWidthRequest="76"
                        HeightRequest="42"
                        Padding="12,0" />
            </Grid>

            <Border Grid.Row="1"
                    Margin="10"
                    Padding="0"
                    BackgroundColor="{StaticResource ViewerBackground}"
                    Stroke="{StaticResource StrokeStrong}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 10">
                <Grid x:Name="FullScreenImageViewport"
                      IsClippedToBounds="True">
                    <Image x:Name="FullScreenSensorImage"
                           Source="{Binding CurrentImage}"
                           Aspect="AspectFit"
                           SizeChanged="OnFullScreenImageSizeChanged"
                           AutomationId="FullScreenSensorImage"
                           SemanticProperties.Description="Tam ekran X-ray görüntüsü">
                        <Image.GestureRecognizers>
                            <PinchGestureRecognizer x:Name="FullScreenPinchGesture"
                                                    PinchUpdated="OnFullScreenImagePinchUpdated" />
                            <PanGestureRecognizer x:Name="FullScreenPanGesture"
                                                  TouchPoints="1"
                                                  PanUpdated="OnFullScreenImagePanUpdated" />
                        </Image.GestureRecognizers>
                    </Image>

                    <!-- Sabit merkez işareti, koordinata odaklanmanın gerçek hedefini gösterir. -->
                    <Grid WidthRequest="24"
                          HeightRequest="24"
                          HorizontalOptions="Center"
                          VerticalOptions="Center"
                          InputTransparent="True">
                        <BoxView HeightRequest="1"
                                 Color="{StaticResource Primary}"
                                 VerticalOptions="Center" />
                        <BoxView WidthRequest="1"
                                 Color="{StaticResource Primary}"
                                 HorizontalOptions="Center" />
                    </Grid>

                    <Border Margin="12"
                            Padding="9,6"
                            BackgroundColor="#CC07101C"
                            Stroke="{StaticResource Stroke}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            HorizontalOptions="Start"
                            VerticalOptions="Start"
                            InputTransparent="True">
                        <Label x:Name="FullScreenCenterCoordinateLabel"
                               Text="MERKEZ X: —  Y: —"
                               TextColor="{StaticResource TextSecondary}"
                               FontFamily="OpenSansSemibold"
                               FontSize="10" />
                    </Border>

                    <Border Margin="12"
                            Padding="9,6"
                            BackgroundColor="#CC07101C"
                            Stroke="{StaticResource Stroke}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            HorizontalOptions="Start"
                            VerticalOptions="End"
                            InputTransparent="True">
                        <Label Text="{Binding FrameMetadataText}"
                               TextColor="{StaticResource Primary}"
                               FontFamily="OpenSansSemibold"
                               FontSize="10" />
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="2"
                  Padding="12,10,12,16"
                  RowDefinitions="Auto,Auto"
                  ColumnDefinitions="Auto,Auto,Auto,*,Auto"
                  RowSpacing="8"
                  ColumnSpacing="7"
                  BackgroundColor="{StaticResource Surface}">
                <Button Text="−"
                        Clicked="OnFullScreenZoomOutClicked"
                        AutomationId="FullScreenZoomOutButton"
                        SemanticProperties.Description="Tam ekran görüntüyü uzaklaştır"
                        WidthRequest="46"
                        HeightRequest="44"
                        Padding="0"
                        FontSize="19" />
                <Label Grid.Column="1"
                       x:Name="FullScreenZoomLevelLabel"
                       Text="100%"
                       WidthRequest="56"
                       TextColor="{StaticResource TextPrimary}"
                       FontFamily="OpenSansSemibold"
                       FontSize="11"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center" />
                <Button Grid.Column="2"
                        Text="+"
                        Clicked="OnFullScreenZoomInClicked"
                        AutomationId="FullScreenZoomInButton"
                        SemanticProperties.Description="Tam ekran görüntüyü yakınlaştır"
                        WidthRequest="46"
                        HeightRequest="44"
                        Padding="0"
                        FontSize="17" />
                <Label Grid.Column="3"
                       Text="PINCH · PAN"
                       Style="{StaticResource CaptionLabelStyle}"
                       VerticalOptions="Center" />
                <Button Grid.Column="4"
                        Text="SIFIRLA"
                        Clicked="OnFullScreenResetZoomClicked"
                        AutomationId="FullScreenResetZoomButton"
                        SemanticProperties.Description="Tam ekran yakınlaştırma ve görüntü konumunu sıfırla"
                        HeightRequest="44"
                        Padding="12,0"
                        FontSize="9" />

                <Grid Grid.Row="1"
                      Grid.ColumnSpan="5"
                      ColumnDefinitions="Auto,*,Auto,*,Auto"
                      ColumnSpacing="6">
                    <Label Text="X"
                           TextColor="{StaticResource TextSecondary}"
                           VerticalTextAlignment="Center" />
                    <Entry Grid.Column="1"
                           x:Name="FullScreenCoordinateXEntry"
                           AutomationId="FullScreenCoordinateXEntry"
                           SemanticProperties.Description="Odaklanılacak görüntü X piksel koordinatı"
                           Keyboard="Numeric"
                           Placeholder="X"
                           HeightRequest="42" />
                    <Label Grid.Column="2"
                           Text="Y"
                           TextColor="{StaticResource TextSecondary}"
                           VerticalTextAlignment="Center" />
                    <Entry Grid.Column="3"
                           x:Name="FullScreenCoordinateYEntry"
                           AutomationId="FullScreenCoordinateYEntry"
                           SemanticProperties.Description="Odaklanılacak görüntü Y piksel koordinatı"
                           Keyboard="Numeric"
                           Placeholder="Y"
                           HeightRequest="42" />
                    <Button Grid.Column="4"
                            Text="ODAKLA"
                            Clicked="OnFullScreenFocusCoordinateClicked"
                            AutomationId="FullScreenFocusCoordinateButton"
                            SemanticProperties.Description="Girilen görüntü koordinatını merkeze al ve yakınlaştır"
                            HeightRequest="42"
                            Padding="12,0"
                            FontSize="9" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
