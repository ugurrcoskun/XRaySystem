<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dto="clr-namespace:XRaySystem.Application.DTOs;assembly=XRaySystem.Application"
    xmlns:vm="clr-namespace:XRaySystem.Mobile.ViewModels"
    x:Class="XRaySystem.Mobile.MainPage"
    x:Name="PageRoot"
    x:DataType="vm:MainViewModel"
    Title="X-Ray Vision Mobile"
    Shell.NavBarIsVisible="False">

    <Grid x:Name="ApplicationRoot">
    <ScrollView x:Name="PageScrollView"
                Orientation="Vertical"
                VerticalScrollBarVisibility="Default">
        <ScrollView.GestureRecognizers>
            <SwipeGestureRecognizer Direction="Left"
                                    Swiped="OnOpenDeviceControlSwiped" />
        </ScrollView.GestureRecognizers>
        <VerticalStackLayout Padding="{OnPlatform Android='16,22,16,30', iOS='18,12,18,32', MacCatalyst='28', WinUI='28'}"
                             Spacing="16"
                             MaximumWidthRequest="1440">

            <!-- Marka ve bağlantı durumu -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                    <Label Text="X-RAY VISION"
                           FontFamily="OpenSansSemibold"
                           FontSize="22"
                           CharacterSpacing="1.2" />
                    <Label Text="MOBILE SENSOR CONSOLE"
                           Style="{StaticResource EyebrowLabelStyle}" />
                </VerticalStackLayout>

                <Border Grid.Column="1"
                        Padding="12,7"
                        VerticalOptions="Center"
                        BackgroundColor="{Binding StatusBadgeBackground}"
                        Stroke="{Binding StatusAccentColor}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20">
                    <HorizontalStackLayout Spacing="7">
                        <Label Text="●"
                               TextColor="{Binding StatusAccentColor}"
                               FontSize="11"
                               VerticalTextAlignment="Center" />
                        <Label Text="{Binding StatusDisplayText}"
                               FontFamily="OpenSansSemibold"
                               FontSize="10"
                               CharacterSpacing="0.8"
                               VerticalTextAlignment="Center" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="2,0">
                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                    <Label Text="WORKSPACE" Style="{StaticResource EyebrowLabelStyle}" />
                    <Label Text="Swipe left for device control"
                           TextColor="{StaticResource TextMuted}"
                           FontSize="11" />
                </VerticalStackLayout>
                <Button Grid.Column="1"
                        Text="DEVICE CONTROL"
                        Clicked="OnOpenDeviceControlClicked"
                        AutomationId="OpenDeviceControlButton"
                        SemanticProperties.Description="Open device connection and acquisition controls"
                        Padding="13,8"
                        MinimumHeightRequest="40"
                        FontSize="10" />
            </Grid>

            <!-- Acquisition iş akışı her ekran genişliğinde aynı dikey sırayı korur. -->
            <Grid x:Name="Workspace"
                  RowDefinitions="Auto,Auto"
                  ColumnDefinitions="*"
                  RowSpacing="16"
                  ColumnSpacing="16">

                <!-- Görüntüleyici -->
                <VerticalStackLayout x:Name="ViewerPanel" Grid.Row="1" Spacing="12">
                    <Border Style="{StaticResource CardStyle}" Padding="12">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
                            <Grid ColumnDefinitions="*,Auto" Padding="4,2">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="GRAB X-RAY MATRIX" Style="{StaticResource EyebrowLabelStyle}" />
                                    <Label Text="Gray16 image viewer" Style="{StaticResource SectionTitleStyle}" />
                                    <Label Text="{Binding DataSourceStatusText}"
                                           TextColor="{Binding DataSourceStatusColor}"
                                           AutomationId="DataSourceStatusLabel"
                                           SemanticProperties.Description="Verified data source for the displayed image"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="9" />
                                </VerticalStackLayout>
                                <Border Grid.Column="1"
                                        Padding="10,6"
                                        BackgroundColor="{Binding StatusBadgeBackground}"
                                        Stroke="{Binding StatusAccentColor}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 14"
                                        VerticalOptions="Center">
                                    <Label Text="{Binding FrameKindDisplay}"
                                           TextColor="{Binding StatusAccentColor}"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="9"
                                           CharacterSpacing="0.8" />
                                </Border>
                            </Grid>

                            <Border Grid.Row="1"
                                    HeightRequest="390"
                                    MinimumHeightRequest="300"
                                    Padding="0"
                                    BackgroundColor="{StaticResource ViewerBackground}"
                                    Stroke="{StaticResource StrokeStrong}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 12">
                                <Grid x:Name="ImageViewport"
                                      IsClippedToBounds="True">
                                    <BoxView Color="#07111F" Opacity="0.42" />
                                    <Grid Opacity="0.16" InputTransparent="True">
                                        <BoxView WidthRequest="1" Color="{StaticResource Primary}" HorizontalOptions="Center" />
                                        <BoxView HeightRequest="1" Color="{StaticResource Primary}" VerticalOptions="Center" />
                                        <Border WidthRequest="210" HeightRequest="210"
                                                BackgroundColor="Transparent"
                                                Stroke="{StaticResource Primary}"
                                                StrokeThickness="1"
                                                StrokeShape="RoundRectangle 105"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center" />
                                    </Grid>

                                    <Image x:Name="SensorImage"
                                           Source="{Binding CurrentImage}"
                                           AutomationId="SensorImage"
                                           SemanticProperties.Description="GRAB, SNAP, or saved X-ray sensor image"
                                           Aspect="AspectFit"
                                           IsVisible="{Binding HasCurrentImage}">
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnOpenFullScreenTapped" />
                                            <PinchGestureRecognizer PinchUpdated="OnImagePinchUpdated" />
                                            <PanGestureRecognizer x:Name="ImagePanGesture"
                                                                  TouchPoints="1"
                                                                  PanUpdated="OnImagePanUpdated" />
                                        </Image.GestureRecognizers>
                                    </Image>

                                    <VerticalStackLayout IsVisible="{Binding HasNoCurrentImage}"
                                                         HorizontalOptions="Center"
                                                         VerticalOptions="Center"
                                                         Spacing="8">
                                        <Border WidthRequest="62" HeightRequest="62"
                                                Padding="0"
                                                BackgroundColor="#101E31"
                                                Stroke="{StaticResource StrokeStrong}"
                                                StrokeThickness="1"
                                                StrokeShape="RoundRectangle 31">
                                            <Label Text="✦"
                                                   TextColor="{StaticResource Primary}"
                                                   FontSize="27"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center" />
                                        </Border>
                                        <Label Text="WAITING FOR SENSOR IMAGE"
                                               Style="{StaticResource EyebrowLabelStyle}"
                                               HorizontalTextAlignment="Center" />
                                        <Label Text="Connect to the device and start GRAB"
                                               TextColor="{StaticResource TextMuted}"
                                               FontSize="12"
                                               HorizontalTextAlignment="Center" />
                                    </VerticalStackLayout>

                                    <Border Margin="12"
                                            Padding="9,6"
                                            BackgroundColor="#CC07101C"
                                            Stroke="{StaticResource Stroke}"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 10"
                                            HorizontalOptions="Start"
                                            VerticalOptions="End">
                                        <Label Text="{Binding FrameMetadataText}"
                                               TextColor="{StaticResource Primary}"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="10" />
                                    </Border>

                                </Grid>
                            </Border>

                            <Border Grid.Row="2"
                                    Padding="7"
                                    BackgroundColor="{StaticResource SurfaceSoft}"
                                    Stroke="{StaticResource Stroke}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 10"
                                    IsEnabled="{Binding HasCurrentImage}">
                                <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto"
                                      ColumnSpacing="6">
                                    <Button Text="−"
                                            AutomationId="ZoomOutButton"
                                            SemanticProperties.Description="Zoom out"
                                            Clicked="OnZoomOutClicked"
                                            WidthRequest="42"
                                            HeightRequest="40"
                                            Padding="0"
                                            FontSize="18" />
                                    <Label Grid.Column="1"
                                           x:Name="ZoomLevelLabel"
                                           Text="100%"
                                           WidthRequest="50"
                                           TextColor="{StaticResource TextPrimary}"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="11"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center" />
                                    <Button Grid.Column="2"
                                            Text="+"
                                            AutomationId="ZoomInButton"
                                            SemanticProperties.Description="Zoom in"
                                            Clicked="OnZoomInClicked"
                                            WidthRequest="42"
                                            HeightRequest="40"
                                            Padding="0"
                                            FontSize="16" />
                                    <Button Grid.Column="3"
                                            Text="FULL SCREEN"
                                            AutomationId="OpenFullScreenViewerButton"
                                            SemanticProperties.Description="Review the image in full screen"
                                            Clicked="OnOpenFullScreenClicked"
                                            HeightRequest="40"
                                            Padding="10,0"
                                            FontSize="9" />
                                    <Button Grid.Column="4"
                                            Text="RESET"
                                            AutomationId="ResetZoomButton"
                                            SemanticProperties.Description="Reset image zoom and position"
                                            Clicked="OnResetZoomClicked"
                                            HeightRequest="40"
                                            Padding="10,0"
                                            FontSize="9" />
                                </Grid>
                            </Border>

                            <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Padding="4,0">
                                <VerticalStackLayout Spacing="1">
                                    <Label Text="{Binding LastFrameTimeText}"
                                           TextColor="{StaticResource TextMuted}"
                                           FontSize="10" />
                                    <Label Text="{Binding FrameFreshnessText}"
                                           AutomationId="FrameFreshnessLabel"
                                           SemanticProperties.Description="Age and freshness state of the latest verified image"
                                           TextColor="{Binding FrameFreshnessColor}"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="10" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1"
                                       Text="16-BIT · LOSSLESS SOURCE"
                                       Style="{StaticResource CaptionLabelStyle}"
                                       TextColor="{StaticResource Primary}" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Mobil Window / Level -->
                    <Border Style="{StaticResource CardStyle}">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <VerticalStackLayout Spacing="1">
                                    <Label Text="WINDOW / LEVEL" Style="{StaticResource EyebrowLabelStyle}" />
                                    <Label Text="Image contrast" Style="{StaticResource SectionTitleStyle}" />
                                </VerticalStackLayout>
                                <Button Grid.Column="1" Text="AUTO"
                                        Command="{Binding AutoWindowLevelCommand}"
                                        Padding="12,7" MinimumHeightRequest="38" />
                                <Button Grid.Column="2" Text="RESET"
                                        Command="{Binding ResetWindowLevelCommand}"
                                        Padding="12,7" MinimumHeightRequest="38" />
                            </Grid>

                            <Grid ColumnDefinitions="58,*,58" RowDefinitions="Auto,Auto" RowSpacing="8" ColumnSpacing="8">
                                <Label Text="CENTER" Style="{StaticResource CaptionLabelStyle}" VerticalOptions="Center" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="65535"
                                        Value="{Binding WindowCenter}" />
                                <Label Grid.Column="2" Text="{Binding WindowCenter, StringFormat='{}{0:F0}'}"
                                       TextColor="{StaticResource Primary}" FontSize="11" HorizontalTextAlignment="End" />

                                <Label Grid.Row="1" Text="WIDTH" Style="{StaticResource CaptionLabelStyle}" VerticalOptions="Center" />
                                <Slider Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="65535"
                                        Value="{Binding WindowWidth}" />
                                <Label Grid.Row="1" Grid.Column="2" Text="{Binding WindowWidth, StringFormat='{}{0:F0}'}"
                                       TextColor="{StaticResource Primary}" FontSize="11" HorizontalTextAlignment="End" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Önce parametreler, ardından cihaz bağlantısı ve acquisition komutları. -->
                <Grid x:Name="ControlPanel"
                      Grid.Row="0"
                      RowDefinitions="Auto,Auto"
                      RowSpacing="12">
                    <Border x:Name="DeviceControlCard"
                            Grid.Row="1"
                            Style="{StaticResource CardStyle}">
                        <VerticalStackLayout Spacing="13">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="DEVICE LINK" Style="{StaticResource EyebrowLabelStyle}" />
                                <Label Text="Device control" Style="{StaticResource SectionTitleStyle}" />
                            </VerticalStackLayout>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                    <Label Text="SYSTEM STATUS" Style="{StaticResource CaptionLabelStyle}" />
                                    <Label Text="{Binding StatusMessage}"
                                           TextColor="{StaticResource TextSecondary}"
                                           FontSize="12"
                                           LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                                <ActivityIndicator Grid.Column="1"
                                                   IsRunning="{Binding IsBusy}"
                                                   IsVisible="{Binding IsBusy}"
                                                   WidthRequest="24"
                                                   HeightRequest="24" />
                            </Grid>

                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="RADIATION" Style="{StaticResource CaptionLabelStyle}" />
                                    <Label Text="{Binding XRayHardwareStateText}"
                                           AutomationId="VerifiedXRayStateLabel"
                                           SemanticProperties.Description="X-ray state verified by the generator"
                                           TextColor="{Binding XRayHardwareStateColor}"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="10" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="HARDWARE" Style="{StaticResource CaptionLabelStyle}" />
                                    <Label Text="{Binding GeneratorHardwareStateText}"
                                           AutomationId="GeneratorHardwareStateLabel"
                                           FontSize="10"
                                           LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding DetectorHardwareStateText}"
                                           AutomationId="DetectorHardwareStateLabel"
                                           FontSize="10"
                                           TextColor="{StaticResource TextSecondary}"
                                           LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2" Spacing="2">
                                    <Label Text="PHASE" Style="{StaticResource CaptionLabelStyle}" />
                                    <Label Text="{Binding AcquisitionCoordinatorStateText}"
                                           AutomationId="AcquisitionCoordinatorStateLabel"
                                           FontSize="10"
                                           TextColor="{StaticResource TextSecondary}"
                                           LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                            </Grid>

                            <BoxView HeightRequest="1"
                                     Color="{StaticResource Stroke}"
                                     Margin="0,2" />

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label Text="OPERATING MODE"
                                       Style="{StaticResource CaptionLabelStyle}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="{Binding ActiveConnectionModeText}"
                                       TextColor="{StaticResource TextSecondary}"
                                       FontSize="10"
                                       VerticalOptions="Center" />
                            </Grid>

                            <Border Padding="10,0"
                                    BackgroundColor="{StaticResource FieldBackground}"
                                    Stroke="{StaticResource Stroke}"
                                    StrokeShape="RoundRectangle 11">
                                <Picker ItemsSource="{Binding ConnectionModeOptions}"
                                        SelectedIndex="{Binding SelectedConnectionModeIndex}"
                                        AutomationId="ConnectionModePicker"
                                        SemanticProperties.Description="Local mock or remote DeviceHost operating mode" />
                            </Border>

                            <VerticalStackLayout Spacing="8"
                                                 IsVisible="{Binding IsRemoteConnectionMode}">
                                <Label Text="DEVICEHOST ADDRESS"
                                       Style="{StaticResource CaptionLabelStyle}" />
                                <Border Padding="10,0"
                                        BackgroundColor="{StaticResource FieldBackground}"
                                        Stroke="{StaticResource Stroke}"
                                        StrokeShape="RoundRectangle 11">
                                    <Entry Text="{Binding DeviceHostUrl}"
                                           Keyboard="Url"
                                           AutomationId="DeviceHostUrlEntry"
                                           SemanticProperties.Description="DeviceHost HTTP or HTTPS address" />
                                </Border>
                                <Label Text="DEVICE ID"
                                       Style="{StaticResource CaptionLabelStyle}" />
                                <Border Padding="10,0"
                                        BackgroundColor="{StaticResource FieldBackground}"
                                        Stroke="{StaticResource Stroke}"
                                        StrokeShape="RoundRectangle 11">
                                    <Entry Text="{Binding RemoteDeviceId}"
                                           AutomationId="RemoteDeviceIdEntry"
                                           SemanticProperties.Description="Remote device identifier" />
                                </Border>
                                <Label Text="DEVICEHOST API KEY"
                                       Style="{StaticResource CaptionLabelStyle}" />
                                <Border Padding="10,0"
                                        BackgroundColor="{StaticResource FieldBackground}"
                                        Stroke="{StaticResource Stroke}"
                                        StrokeShape="RoundRectangle 11">
                                    <Entry Text="{Binding RemoteApiKey}"
                                           IsPassword="True"
                                           Placeholder="Leave blank to keep the stored key"
                                           AutomationId="DeviceHostApiKeyEntry"
                                           SemanticProperties.Description="DeviceHost operator API key" />
                                </Border>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label Text="{Binding DeviceHostCredentialStatusText}"
                                           TextColor="{StaticResource TextMuted}"
                                           FontSize="11"
                                           VerticalOptions="Center" />
                                    <Button Grid.Column="1"
                                            Text="DELETE KEY"
                                            AutomationId="ClearDeviceHostApiKeyButton"
                                            SemanticProperties.Hint="Deletes the stored DeviceHost API key from secure storage"
                                            Command="{Binding ClearDeviceHostApiKeyCommand}" />
                                </Grid>
                            </VerticalStackLayout>

                            <Button Text="SAVE CONNECTION SETTINGS"
                                    AutomationId="SaveConnectionSettingsButton"
                                    SemanticProperties.Hint="Saves the selected operating mode for the next app launch"
                                    Command="{Binding ApplyConnectionSettingsCommand}" />

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="9">
                                <Button Text="CONNECT"
                                        AutomationId="ConnectButton"
                                        SemanticProperties.Hint="Connects to the selected X-ray sensor service"
                                        Command="{Binding ConnectCommand}"
                                        Style="{StaticResource PrimaryActionButton}" />
                                <Button Grid.Column="1" Text="DISCONNECT"
                                        AutomationId="DisconnectButton"
                                        SemanticProperties.Hint="Safely closes the active sensor connection"
                                        Command="{Binding DisconnectCommand}"
                                        Style="{StaticResource DangerActionButton}" />
                            </Grid>

                            <BoxView HeightRequest="1"
                                     Color="{StaticResource Stroke}"
                                     Margin="0,2" />

                            <VerticalStackLayout Spacing="2">
                                <Label Text="ACQUISITION COMMANDS" Style="{StaticResource EyebrowLabelStyle}" />
                                <Label Text="Device operations" Style="{StaticResource SectionTitleStyle}" />
                            </VerticalStackLayout>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="9">
                                <Button Text="{Binding StartLiveActionText}"
                                        AutomationId="StartLiveButton"
                                        SemanticProperties.Description="Start the low-resolution GRAB image stream"
                                        Command="{Binding StartLiveCommand}"
                                        Style="{StaticResource SuccessActionButton}" />
                                <Button Grid.Column="1" Text="FREEZE"
                                        AutomationId="StopLiveButton"
                                        SemanticProperties.Description="Freeze the active GRAB stream and preserve the latest image"
                                        Command="{Binding StopLiveCommand}"
                                        Style="{StaticResource BaseButtonStyle}" />
                            </Grid>

                            <Button Text="{Binding SnapActionText}"
                                    AutomationId="SnapButton"
                                    SemanticProperties.Hint="Acquire one image in the selected LOW or RAW detector mode"
                                    Command="{Binding SnapCommand}"
                                    Style="{StaticResource SnapActionButton}" />

                            <VerticalStackLayout Spacing="5">
                                <Button Text="STOP"
                                        AutomationId="AbortButton"
                                        SemanticProperties.Description="Immediately route the active GRAB or SNAP operation to safe shutdown"
                                        SemanticProperties.Hint="This software command does not replace the equipment hardware emergency stop"
                                        Command="{Binding AbortCommand}"
                                        Style="{StaticResource AbortAcquisitionButton}" />
                                <Label Text="·Immediate safe shutdown for an active GRAB or SNAP."
                                       TextColor="{StaticResource Danger}"
                                       FontSize="10"
                                       HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>

                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                        <VerticalStackLayout Spacing="13">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="PARAMETERS" Style="{StaticResource EyebrowLabelStyle}" />
                                    <Label Text="Acquisition parameters" Style="{StaticResource SectionTitleStyle}" />
                                </VerticalStackLayout>
                                <Button Grid.Column="1" Text="DEFAULTS"
                                        Command="{Binding ResetParametersCommand}"
                                        Padding="10,6" MinimumHeightRequest="36" FontSize="9" />
                            </Grid>

                            <Label Text="X-RAY GENERATOR"
                                   Style="{StaticResource EyebrowLabelStyle}" />

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="9">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="TUBE VOLTAGE" Style="{StaticResource CaptionLabelStyle}" />
                                    <Border Padding="11,0" BackgroundColor="{StaticResource FieldBackground}"
                                            Stroke="{StaticResource Stroke}" StrokeShape="RoundRectangle 11">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Entry Text="{Binding Kv}" Keyboard="Numeric" ReturnType="Next"
                                                   AutomationId="VoltageEntry"
                                                   SemanticProperties.Description="Tube voltage in kilovolts" />
                                            <Label Grid.Column="1" Text="kV" TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
                                        </Grid>
                                    </Border>
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1" Spacing="6">
                                    <Label Text="TUBE POWER" Style="{StaticResource CaptionLabelStyle}" />
                                    <Border Padding="11,0" BackgroundColor="{StaticResource FieldBackground}"
                                            Stroke="{StaticResource Stroke}" StrokeShape="RoundRectangle 11">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Entry Text="{Binding Watt}" Keyboard="Numeric" ReturnType="Next"
                                                   AutomationId="PowerEntry"
                                                   SemanticProperties.Description="Tube power in watts" />
                                            <Label Grid.Column="1" Text="W" TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
                                        </Grid>
                                    </Border>
                                </VerticalStackLayout>
                            </Grid>

                            <Label Text="DETECTOR"
                                   Style="{StaticResource EyebrowLabelStyle}"
                                   Margin="0,4,0,0" />

                            <VerticalStackLayout Spacing="6">
                                <Label Text="EXPOSURE TIME" Style="{StaticResource CaptionLabelStyle}" />
                                <Border Padding="11,0" BackgroundColor="{StaticResource FieldBackground}"
                                        Stroke="{Binding ParametersAccentColor}" StrokeShape="RoundRectangle 11">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Entry Text="{Binding ExposureTime}" Keyboard="Numeric" ReturnType="Done"
                                               AutomationId="ExposureEntry"
                                               SemanticProperties.Description="Exposure time in milliseconds" />
                                        <Label Grid.Column="1" Text="ms" TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="6">
                                <Label Text="SNAP DETECTOR MODE" Style="{StaticResource CaptionLabelStyle}" />
                                <Border Padding="10,0"
                                        BackgroundColor="{StaticResource FieldBackground}"
                                        Stroke="{StaticResource Stroke}"
                                        StrokeShape="RoundRectangle 11">
                                    <Picker ItemsSource="{Binding SnapFrameModeOptions}"
                                            SelectedItem="{Binding SelectedSnapFrameMode}"
                                            IsEnabled="{Binding CanSelectSnapFrameMode}"
                                            AutomationId="SnapFrameModePicker"
                                            SemanticProperties.Description="LOW or RAW detector acquisition mode for SNAP" />
                                </Border>
                            </VerticalStackLayout>

                            <Label Text="{Binding ParametersValidationMessage}"
                                   TextColor="{Binding ParametersAccentColor}"
                                   FontSize="10"
                                   LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </Grid>

            <!-- Son sensör ölçümleri -->
            <VerticalStackLayout Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="GRAB TELEMETRY" Style="{StaticResource EyebrowLabelStyle}" />
                        <Label Text="Latest sensor measurement" Style="{StaticResource SectionTitleStyle}" />
                    </VerticalStackLayout>
                    <Label Grid.Column="1" Text="{Binding LastFrameTimeText}"
                           TextColor="{StaticResource TextMuted}" FontSize="10" VerticalOptions="End" />
                </Grid>

                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                    <Border Style="{StaticResource SoftCardStyle}">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="TUBE POWER" Style="{StaticResource CaptionLabelStyle}" />
                            <HorizontalStackLayout Spacing="5">
                                <Label Text="{Binding MeasuredPowerW, StringFormat='{}{0:F1}'}" Style="{StaticResource MetricValueStyle}" />
                                <Label Text="W" TextColor="{StaticResource TextMuted}" VerticalOptions="End" Margin="0,0,0,4" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource SoftCardStyle}">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="TUBE VOLTAGE" Style="{StaticResource CaptionLabelStyle}" />
                            <HorizontalStackLayout Spacing="5">
                                <Label Text="{Binding MeasuredVoltageKv, StringFormat='{}{0:F1}'}" Style="{StaticResource MetricValueStyle}" />
                                <Label Text="kV" TextColor="{StaticResource TextMuted}" VerticalOptions="End" Margin="0,0,0,4" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource SoftCardStyle}">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="EXPOSURE" Style="{StaticResource CaptionLabelStyle}" />
                            <HorizontalStackLayout Spacing="5">
                                <Label Text="{Binding MeasuredExposureMs, StringFormat='{}{0:F0}'}" Style="{StaticResource MetricValueStyle}" />
                                <Label Text="ms" TextColor="{StaticResource TextMuted}" VerticalOptions="End" Margin="0,0,0,4" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource SoftCardStyle}">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="INTENSITY" Style="{StaticResource CaptionLabelStyle}" />
                            <HorizontalStackLayout Spacing="5">
                                <Label Text="{Binding MeasuredIntensity, StringFormat='{}{0:F0}'}"
                                       Style="{StaticResource MetricValueStyle}"
                                       TextColor="{StaticResource Primary}" />
                                <Label Text="B" TextColor="{StaticResource TextMuted}" VerticalOptions="End" Margin="0,0,0,4" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </VerticalStackLayout>

            <!-- Mobil yerel görüntü geçmişi -->
            <Border Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="LOCAL HISTORY" Style="{StaticResource EyebrowLabelStyle}" />
                            <Label Text="Recent mobile captures" Style="{StaticResource SectionTitleStyle}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1"
                                Text="REFRESH"
                                Command="{Binding RefreshHistoryCommand}"
                                Padding="12,7"
                                MinimumHeightRequest="38" />
                    </Grid>

                    <Grid IsVisible="{Binding HasNoRecentImages}" HeightRequest="92">
                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="5">
                            <Label Text="◇" TextColor="{StaticResource TextMuted}" FontSize="24" HorizontalTextAlignment="Center" />
                            <Label Text="No mobile SNAP has been saved yet"
                                   TextColor="{StaticResource TextMuted}"
                                   FontSize="11"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Grid>

                    <CollectionView x:Name="HistoryCollectionView"
                                    ItemsSource="{Binding RecentImages}"
                                    IsVisible="{Binding HasRecentImages}"
                                    HeightRequest="344"
                                    SelectionMode="None"
                                    ItemSizingStrategy="MeasureFirstItem"
                                    VerticalScrollBarVisibility="Always"
                                    AutomationId="MobileCapturesList"
                                    SemanticProperties.Description="Scrollable list of recent mobile captures">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="dto:SensorDataDto">
                                <Border Margin="0"
                                        Padding="10"
                                        HorizontalOptions="Fill"
                                        BackgroundColor="{StaticResource SurfaceSoft}"
                                        Stroke="{StaticResource Stroke}"
                                        StrokeShape="RoundRectangle 13"
                                        SemanticProperties.Hint="Opens the saved image in the full review viewer">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.LoadHistoryImageCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Grid RowDefinitions="88,Auto" RowSpacing="8">
                                        <Border Padding="0"
                                                BackgroundColor="{StaticResource ViewerBackground}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 9">
                                            <Image Source="{Binding ImagePath}" Aspect="AspectFill" />
                                        </Border>
                                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <VerticalStackLayout Spacing="4">
                                                <Label Text="{Binding Timestamp, StringFormat='{}{0:dd.MM · HH:mm}'}"
                                                       TextColor="{StaticResource TextPrimary}"
                                                       FontFamily="OpenSansSemibold"
                                                       FontSize="11" />
                                                <HorizontalStackLayout Spacing="10">
                                                    <Label Text="{Binding Voltage, StringFormat='{}{0:F0} kV'}"
                                                           TextColor="{StaticResource Primary}"
                                                           FontFamily="OpenSansSemibold"
                                                           FontSize="10" />
                                                    <Label Text="{Binding PowerW, StringFormat='{}{0:F0} W'}"
                                                           TextColor="{StaticResource Primary}"
                                                           FontFamily="OpenSansSemibold"
                                                           FontSize="10" />
                                                    <Label Text="{Binding ExposureTime, StringFormat='{}{0:F0} ms'}"
                                                           TextColor="{StaticResource Primary}"
                                                           FontFamily="OpenSansSemibold"
                                                           FontSize="10" />
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1"
                                                   Text="REVIEW"
                                                   Style="{StaticResource CaptionLabelStyle}"
                                                   VerticalOptions="Center" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,Auto" Margin="2,8,2,0">
                <Label Text="{Binding DataSourceStatusText}"
                       TextColor="{Binding DataSourceStatusColor}"
                       Style="{StaticResource CaptionLabelStyle}" />
                <Label Grid.Column="1" Text="XRS MOBILE 1.4"
                       Style="{StaticResource CaptionLabelStyle}"
                       TextColor="{StaticResource Primary}" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>

        <!-- Device control is a separate horizontal workspace. The existing
             control card is re-parented into DeviceControlContentHost during
             page construction so bindings and AutomationId values stay stable. -->
        <Grid x:Name="DeviceControlPage"
              IsVisible="False"
              ZIndex="50"
              BackgroundColor="{StaticResource PageBackground}"
              AutomationId="DeviceControlPage">
            <Grid.GestureRecognizers>
                <SwipeGestureRecognizer Direction="Right"
                                        Swiped="OnCloseDeviceControlSwiped" />
            </Grid.GestureRecognizers>

            <ScrollView x:Name="DeviceControlScrollView"
                        Orientation="Vertical"
                        VerticalScrollBarVisibility="Default">
                <VerticalStackLayout Padding="{OnPlatform Android='16,22,16,30', iOS='18,12,18,32', MacCatalyst='28', WinUI='28'}"
                                     Spacing="16"
                                     MaximumWidthRequest="760">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Button Text="BACK"
                                Clicked="OnCloseDeviceControlClicked"
                                AutomationId="CloseDeviceControlButton"
                                SemanticProperties.Description="Return to the imaging workspace"
                                Padding="12,8"
                                MinimumHeightRequest="40"
                                FontSize="10" />
                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="1"
                                             VerticalOptions="Center">
                            <Label Text="DEVICE CONTROL"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="20" />
                            <Label Text="Connection and acquisition operations"
                                   TextColor="{StaticResource TextMuted}"
                                   FontSize="11" />
                        </VerticalStackLayout>
                        <Border Grid.Column="2"
                                Padding="10,6"
                                VerticalOptions="Center"
                                BackgroundColor="{Binding StatusBadgeBackground}"
                                Stroke="{Binding StatusAccentColor}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 16">
                            <Label Text="{Binding StatusDisplayText}"
                                   TextColor="{Binding StatusAccentColor}"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="9" />
                        </Border>
                    </Grid>

                    <Grid x:Name="DeviceControlContentHost" />

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="2,4,2,0">
                        <Label Text="2 / 2"
                               Style="{StaticResource CaptionLabelStyle}"
                               TextColor="{StaticResource Primary}" />
                        <Label Grid.Column="1"
                               Text="Swipe right to return to the imaging workspace"
                               Style="{StaticResource CaptionLabelStyle}"
                               HorizontalTextAlignment="End" />
                    </Grid>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>

        <!-- Telefonda görüntü incelemeyi sayfa ScrollView'undan ayırır. -->
        <Grid x:Name="FullScreenViewerOverlay"
              IsVisible="False"
              ZIndex="100"
              BackgroundColor="{StaticResource ViewerBackground}"
              AutomationId="FullScreenImageViewer">
            <Grid x:Name="FullScreenImageViewport"
                  IsClippedToBounds="True"
                  BackgroundColor="{StaticResource ViewerBackground}">
                <Image x:Name="FullScreenSensorImage"
                       Source="{Binding CurrentImage}"
                       Aspect="AspectFit"
                       SizeChanged="OnFullScreenImageSizeChanged"
                       AutomationId="FullScreenSensorImage"
                       SemanticProperties.Description="Full-screen X-ray image">
                    <Image.GestureRecognizers>
                        <PinchGestureRecognizer x:Name="FullScreenPinchGesture"
                                                PinchUpdated="OnFullScreenImagePinchUpdated" />
                        <PanGestureRecognizer x:Name="FullScreenPanGesture"
                                              TouchPoints="1"
                                              PanUpdated="OnFullScreenImagePanUpdated" />
                    </Image.GestureRecognizers>
                </Image>

                <GraphicsView x:Name="FullScreenPixelGrid"
                              InputTransparent="True"
                              IsVisible="False"
                              AutomationProperties.IsInAccessibleTree="False" />

                <Grid WidthRequest="24"
                      HeightRequest="24"
                      HorizontalOptions="Center"
                      VerticalOptions="Center"
                      InputTransparent="True">
                    <BoxView HeightRequest="1"
                             Color="{StaticResource Primary}"
                             VerticalOptions="Center" />
                    <BoxView WidthRequest="1"
                             Color="{StaticResource Primary}"
                             HorizontalOptions="Center" />
                </Grid>
            </Grid>

            <Border Margin="10"
                    Padding="9,7"
                    BackgroundColor="#D907101C"
                    Stroke="{StaticResource Stroke}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    HorizontalOptions="Start"
                    VerticalOptions="Start"
                    InputTransparent="True">
                <VerticalStackLayout Spacing="2">
                    <Label x:Name="FullScreenCenterCoordinateLabel"
                           Text="CENTER X: —  Y: —"
                           TextColor="{StaticResource TextPrimary}"
                           FontFamily="OpenSansSemibold"
                           FontSize="10" />
                    <Label Text="{Binding FrameMetadataText}"
                           TextColor="{StaticResource Primary}"
                           FontFamily="OpenSansSemibold"
                           FontSize="9" />
                    <Label Text="{Binding DataSourceStatusText}"
                           TextColor="{Binding DataSourceStatusColor}"
                           AutomationId="FullScreenDataSourceStatusLabel"
                           SemanticProperties.Description="Verified data source for the full-screen image"
                           FontFamily="OpenSansSemibold"
                           FontSize="8" />
                </VerticalStackLayout>
            </Border>

            <Button Text="CLOSE"
                    Margin="10"
                    HorizontalOptions="End"
                    VerticalOptions="Start"
                    Clicked="OnCloseFullScreenClicked"
                    AutomationId="CloseFullScreenViewerButton"
                    SemanticProperties.Description="Close full-screen image review"
                    MinimumWidthRequest="76"
                    HeightRequest="44"
                    Padding="12,0" />

            <Border Margin="10,10,10,12"
                    Padding="7"
                    BackgroundColor="#E6101827"
                    Stroke="{StaticResource StrokeStrong}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 10"
                    HorizontalOptions="Fill"
                    VerticalOptions="End">
                <Grid RowDefinitions="Auto,Auto"
                      ColumnDefinitions="Auto,Auto,Auto,*,Auto"
                      RowSpacing="6"
                      ColumnSpacing="6">
                    <Button Text="−"
                            Clicked="OnFullScreenZoomOutClicked"
                            AutomationId="FullScreenZoomOutButton"
                            SemanticProperties.Description="Zoom out in the full-screen image"
                            WidthRequest="44"
                            HeightRequest="42"
                            Padding="0"
                            FontSize="19" />
                    <Label Grid.Column="1"
                           x:Name="FullScreenZoomLevelLabel"
                           Text="100%"
                           WidthRequest="52"
                           TextColor="{StaticResource TextPrimary}"
                           FontFamily="OpenSansSemibold"
                           FontSize="11"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center" />
                    <Button Grid.Column="2"
                            Text="+"
                            Clicked="OnFullScreenZoomInClicked"
                            AutomationId="FullScreenZoomInButton"
                            SemanticProperties.Description="Zoom in on the full-screen image"
                            WidthRequest="44"
                            HeightRequest="42"
                            Padding="0"
                            FontSize="17" />
                    <Label Grid.Column="3"
                           Text="PINCH · PAN"
                           Style="{StaticResource CaptionLabelStyle}"
                           VerticalOptions="Center" />
                    <Button Grid.Column="4"
                            Text="RESET"
                            Clicked="OnFullScreenResetZoomClicked"
                            AutomationId="FullScreenResetZoomButton"
                            SemanticProperties.Description="Reset full-screen zoom and image position"
                            HeightRequest="42"
                            Padding="10,0"
                            FontSize="9" />

                    <Grid Grid.Row="1"
                          Grid.ColumnSpan="5"
                          ColumnDefinitions="Auto,*,Auto,*,Auto"
                          ColumnSpacing="6">
                        <Label Text="X"
                               TextColor="{StaticResource TextSecondary}"
                               VerticalTextAlignment="Center" />
                        <Entry Grid.Column="1"
                               x:Name="FullScreenCoordinateXEntry"
                               AutomationId="FullScreenCoordinateXEntry"
                               SemanticProperties.Description="Image X pixel coordinate to focus"
                               Keyboard="Numeric"
                               Placeholder="X"
                               HeightRequest="42" />
                        <Label Grid.Column="2"
                               Text="Y"
                               TextColor="{StaticResource TextSecondary}"
                               VerticalTextAlignment="Center" />
                        <Entry Grid.Column="3"
                               x:Name="FullScreenCoordinateYEntry"
                               AutomationId="FullScreenCoordinateYEntry"
                               SemanticProperties.Description="Image Y pixel coordinate to focus"
                               Keyboard="Numeric"
                               Placeholder="Y"
                               HeightRequest="42" />
                        <Button Grid.Column="4"
                                Text="FOCUS"
                                Clicked="OnFullScreenFocusCoordinateClicked"
                                AutomationId="FullScreenFocusCoordinateButton"
                                SemanticProperties.Description="Center and zoom to the entered image coordinate"
                                HeightRequest="42"
                                Padding="10,0"
                                FontSize="9" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="AppDialogOverlay"
              IsVisible="False"
              ZIndex="200"
              Padding="22"
              BackgroundColor="#B3000000"
              AutomationId="AppMessageDialog">
            <Border MaximumWidthRequest="520"
                    Padding="0"
                    HorizontalOptions="Fill"
                    VerticalOptions="Center"
                    BackgroundColor="{StaticResource Surface}"
                    Stroke="{StaticResource StrokeStrong}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14">
                <Grid ColumnDefinitions="5,*">
                    <BoxView x:Name="AppDialogAccent" Color="{StaticResource Danger}" />
                    <VerticalStackLayout Grid.Column="1" Padding="22,20" Spacing="12">
                        <Label x:Name="AppDialogSeverityLabel"
                               Text="ACTION REQUIRED"
                               TextColor="{StaticResource Danger}"
                               Style="{StaticResource EyebrowLabelStyle}" />
                        <Label x:Name="AppDialogTitleLabel"
                               Text="System Error"
                               TextColor="{StaticResource TextPrimary}"
                               FontFamily="OpenSansSemibold"
                               FontSize="20" />
                        <ScrollView MaximumHeightRequest="320">
                            <Label x:Name="AppDialogMessageLabel"
                                   TextColor="{StaticResource TextSecondary}"
                                   FontSize="14"
                                   LineHeight="1.35" />
                        </ScrollView>
                        <Button Text="OK"
                                HorizontalOptions="End"
                                MinimumWidthRequest="104"
                                Clicked="OnAppDialogDismissed"
                                AutomationId="DismissAppMessageButton"
                                Style="{StaticResource PrimaryActionButton}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
